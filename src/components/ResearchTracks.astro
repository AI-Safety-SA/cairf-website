---
// Research Tracks section component
import ApplyButton from './ApplyButton.astro';
import TextDropdown from './TextDropdown.astro';
import { Image } from 'astro:assets';
import robotBees from '../assets/images/robot-bees.jpg';
import humanCooperation from '../assets/images/human-cooperation.jpg';
import gradualDisempowerment from '../assets/images/gradual-disempowerment.jpg';
import wildCard from '../assets/images/Bokkies.jpg';

// Research tracks data
const researchTracks = [
  {
    title: "Multi-Agent Safety",
    description: "This research area serves to develop the nascent field of understanding risks of and preventing harm from large systems of autonomous AI agents. The focus is on cooperation problems in mixed-motive settings: situations where individual agents or groups would benefit from working together, yet have incentives that make cooperation difficult or unstable. Work in this area includes:",
    image: robotBees,
    points: [
      "Investigating how to monitor and control the collective dynamics arising from interactions within multi-agent networks (more).",
      "Investigating strategies to detect and prevent collusion (more).",
      "Understanding and evaluating abilities and propensities of AI agents that determine how they behave in cooperation problems (more here and here).",
      "Propose infrastructure and incentive structures that could promote safe interactions between agents (more).",
      "Studying the effects of information asymmetries on the safety of multiagent interactions (more).",
      "Identifying and mitigating AI security vulnerabilities that are specific to mixed-motive, multi-agent settings (more).",
      "Exploring collective epistemics in LLMs and assess the impact on prosocial outcomes."
    ],
    link: "See the associated grant areas on the Cooperative AI Foundation website for more details."
  },
  {
    title: "AI for Facilitating Human Cooperation",
    description: "Many of the greatest challenges that humanity faces can be understood as cooperation challenges, where we would benefit from working together, yet have incentives that make cooperation difficult or unstable. In this area, we would like to see proposals to develop AI tools that help humans resolve major cooperation challenges. By virtue of their potentially greater ability to identify mutually beneficial agreements or to create novel institutional designs, for example, AI systems could have a huge positive impact via helping humans to cooperate.",
    image: humanCooperation,
    points: [],
    link: "See the associated grant area on the Cooperative AI Foundation website for more details."
  },
  {
    title: "Mitigating Gradual Disempowerment",
    description: "As AI deployment increases and critical social systems — like economy, state, culture — become less reliant on human labor and cognition, the extent to which humans can explicitly or implicitly align such social systems could dramatically decrease. Competitive pressures and 'wicked' interactions across systems and scales could make it systematically difficult to avoid outsourcing critical societal functions to AI. As a result, these systems —and the outcomes they produce— might drift further from providing what humans want. In this area, we're looking to develop mitigations to preserve human agency and ensure that our institutions serve us.",
    image: gradualDisempowerment,
    points: [],
    link: "You can read more about this topic here."
  },
  {
    title: "Wildcard",
    description: "Pitch us a project! The outcome of your project must necessarily reduce catastrophic outcomes that arise as a result of AI, but other than that there are no constraints here. Note that you may be less likely to be matched with a mentor (and therefore accepted to the fellowship) if you choose this option, but we will make an effort to find mentors for exceptional candidates that don't exactly fit the tracks above.",
    image: wildCard,
    points: [],
    link: ""
  },
];
---
<section id="tracks" class="py-20 bg-green-dark text-white">
  <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-left mb-4">
      Research Areas
    </h2>
    
    <p class="text-lg text-white text-left mb-12">
      We have identified the following tracks for the fellowship.
    </p>
    <!-- TODO add clickable links to the 'link' fields -->
    <!-- TODO Mobile iamges not covering entire page width -->
    <!-- TODO Desktop Multi agent safety needs to have the points be hidden by a text 'show more' button, 
        and should expand the text section when clicked. 
        There should then be a 'show less' button right at the end of the fully expanded text section -->
    <!-- TODO might be simpler to move away from a component-ish layout for this page and instead have each section defined and the content added into it. -->

    <!-- Desktop version: Text and image layout -->
    <div class="hidden md:block">
      {researchTracks.map((track, index) => (
        <div class="mb-16">
          <div class={`flex items-center gap-12 ${index % 2 === 1 ? 'flex-row-reverse' : ''}`}>
            <!-- Text content -->
            <div class="flex-1">
              <h3 class="text-2xl font-semibold text-white mb-6">
                {track.title}
              </h3>
              
              <p class="text-white/80 mb-6 leading-relaxed">
                {track.description}
              </p>
              
              {track.points.length > 0 && (
                <ul class="text-white/80 space-y-3 mb-6">
                  {track.points.map((point) => (
                    <li class="flex items-start">
                      <span class="text-white mr-3 mt-1">•</span>
                      <span class="leading-relaxed">{point}</span>
                    </li>
                  ))}
                </ul>
              )}
              
              {track.link && (
                <p class="text-white/80 text-sm">
                  <a href="#" class="underline hover:text-white transition-colors">
                    {track.link}
                  </a>
                </p>
              )}
            </div>
            
            <!-- Image -->
            <div class="flex-shrink-0 w-124">
              <Image 
                src={track.image} 
                alt={track.title}
                class="w-full h-auto"
                width={400}
                height={300}
              />
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Mobile version: Full-width images with dropdowns -->
    <div class="md:hidden">
      {researchTracks.map((track, index) => (
        <div class="mb-8">
          <!-- Full-width image -->
          <div class="mb-4">
            <Image 
              src={track.image} 
              alt={track.title}
              class="w-full h-auto"
              width={400}
              height={300}
            />
          </div>
          
          <!-- Dropdown section -->
          <TextDropdown 
            title={track.title}
            content={[
              track.description,
              ...track.points
            ]}
            link={track.link}
            isLast={index === researchTracks.length - 1}
            isOpen={index === 0}
          />
        </div>
      ))}
    </div>
    
    <!-- Apply button -->
    <div class="mt-12">
      <div class="flex justify-center lg:justify-end">
        <ApplyButton variant="primary" />
      </div>
    </div>
  </div>
</section>
