---
// Research Tracks section component
---

<section class="py-20 bg-yellow-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12">
      Research Tracks
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- AI for coordination, fairness and transparency -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          AI for coordination, fairness and transparency
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Multi-agent coordination algorithms</li>
          <li>• Fairness in AI decision making</li>
          <li>• Transparency and interpretability</li>
          <li>• Ethical AI frameworks</li>
        </ul>
      </div>
      
      <!-- AI for Democracy -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          AI for Democracy
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Democratic decision-making systems</li>
          <li>• Collective intelligence</li>
          <li>• Participatory governance</li>
          <li>• Civic technology applications</li>
        </ul>
      </div>
      
      <!-- AI for Reducing Human Cooperation -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          AI for Reducing Human Cooperation
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Conflict resolution algorithms</li>
          <li>• Cooperation barriers analysis</li>
          <li>• Human-AI collaboration</li>
          <li>• Social dynamics modeling</li>
        </ul>
      </div>
      
      <!-- Multi-agent Security -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          Multi-agent Security
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Secure multi-agent systems</li>
          <li>• Adversarial cooperation</li>
          <li>• Trust mechanisms</li>
          <li>• Security protocols</li>
        </ul>
      </div>
      
      <!-- Culture -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          Culture
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Cultural cooperation patterns</li>
          <li>• Cross-cultural AI systems</li>
          <li>• Cultural bias mitigation</li>
          <li>• Indigenous knowledge integration</li>
        </ul>
      </div>
      
      <!-- Interacting Cooperators -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          Interacting Cooperators
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Cooperative interaction models</li>
          <li>• Social learning algorithms</li>
          <li>• Emergent cooperation</li>
          <li>• Network effects</li>
        </ul>
      </div>
      
      <!-- Monitoring and Control of Communication -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          Monitoring and Control of Communication
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Communication protocols</li>
          <li>• Information flow control</li>
          <li>• Privacy-preserving communication</li>
          <li>• Communication efficiency</li>
        </ul>
      </div>
      
      <!-- Debiasing Cooperative Human Decisions -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          Debiasing Cooperative Human Decisions
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Cognitive bias identification</li>
          <li>• Decision-making frameworks</li>
          <li>• Bias mitigation strategies</li>
          <li>• Human-AI decision support</li>
        </ul>
      </div>
      
      <!-- Debiasing Cooperative Robot Properties -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">
          Debiasing Cooperative Robot Properties
        </h3>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>• Robot behavior optimization</li>
          <li>• Cooperative robotics</li>
          <li>• Bias-free robot design</li>
          <li>• Human-robot interaction</li>
        </ul>
      </div>
    </div>
    
    <!-- Apply button at bottom right -->
    <div class="flex justify-end mt-12">
      <a href="#apply" class="inline-block bg-orange-500 hover:bg-orange-600 text-white px-8 py-4 rounded-md text-lg font-semibold transition-colors duration-200">
        APPLY NOW
      </a>
    </div>
  </div>
</section>
