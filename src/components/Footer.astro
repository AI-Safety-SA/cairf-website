---
// Footer component
---

<footer class="bg-black text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <!-- Left side - Logo -->
      <div class="flex items-center mb-6 md:mb-0">
        <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center mr-3">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div>
          <span class="text-xl font-semibold">Cooperative AI South Africa Fellowship</span>
          <p class="text-sm text-text-muted mt-1">An AI Safety South Africa program.</p>
        </div>
      </div>
      
      <!-- Center - Contact -->
      <div class="text-center mb-6 md:mb-0">
        <p class="text-text-muted mb-2">Get in touch with us at contact@caisaf.org</p>
        <div class="flex justify-center space-x-4">
          <a href="#" class="text-text-muted hover:text-white transition-colors">
            <span class="text-sm">LinkedIn</span>
          </a>
          <a href="#" class="text-text-muted hover:text-white transition-colors">
            <span class="text-sm">Substack</span>
          </a>
        </div>
      </div>
      
      <!-- Right side - Copyright -->
      <div class="text-sm text-text-muted">
        © 2025 Cooperative AI South Africa Fellowship
      </div>
    </div>
  </div>
</footer>
