---
// Footer component
import { Image } from "astro:assets";

import LinkedInIcon from "../assets/icons/linkedin-brands-solid-full.svg";
import SubstackIcon from "../assets/icons/substack.png";
import CairfLogo from "../assets/logos/cairf_logo.png";
import AissaLogo from "../assets/logos/aissa_logo_black_no_text.svg";

const isHomePage = Astro.url.pathname === '/';
const heroHref = isHomePage ? '#hero' : '/#hero';
---

<footer class="bg-white text-text-base py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Mobile layout - centered vertical -->
    <div class="flex flex-col items-center text-center md:hidden">
      <div class="mb-4">
        <a href={heroHref}>
          <Image src={CairfLogo} alt="Cooperative AI Research Fellowship Logo" class="w-auto h-16 mb-2" />
        </a>
        <p class="text-sm text-gray-600 mb-6">An AI Safety South Africa program.</p>
      </div>
      
      <div class="mb-6">
        <p class="text-text-base mb-2">Get in touch with us at <a href="mailto:info@cai-research-fellowship.com" class="text-text-base hover:text-gray-600 transition-colors">info@cai-research-fellowship.com</a></p>      
        <p class="text-text-base"><a href="/fellows" class="hover:text-gray-600 transition-colors">Meet the Fellows</a></p>
      </div>
        <div class="flex justify-center space-x-4">
          <a href="https://www.aisafetysa.com" target="_blank" rel="noopener noreferrer" class="flex items-center">
            <Image src={AissaLogo} alt="AISSA Logo" class="w-8 h-8" />
          </a>
          <a href="https://www.linkedin.com/company/ai-safety-south-africa/" target="_blank" rel="noopener noreferrer" class="text-[#0077B5] flex items-center">
            <Image src={LinkedInIcon} alt="LinkedIn" class="w-8 h-8" />
          </a>
          <a href="https://aisafetycapetown.substack.com/" target="_blank" rel="noopener noreferrer" class="text-[#FF6314] flex items-center">
            <Image src={SubstackIcon} alt="Substack" class="w-8 h-8" />
          </a>
        </div>
    </div>

    <!-- Desktop layout - horizontal -->
    <div class="hidden md:flex flex-row justify-between items-center">
      <!-- Left side - Logo and Program Info -->
      <div class="flex items-center space-x-4">
        <div class="flex flex-col">
          <a href={heroHref}>
            <Image src={CairfLogo} alt="Cooperative AI Research Fellowship Logo" class="w-auto h-12 mb-2" />
          </a>
          <p class="text-sm text-gray-600">An AI Safety South Africa program.</p>
        </div>
      </div>
      
      <!-- Right - Contact and Social -->
      <div class="text-right">
        <p class="text-text-base mb-2">Get in touch with us at <a href="mailto:info@cai-research-fellowship.com" class="text-text-base hover:text-gray-600 transition-colors">info@cai-research-fellowship.com</a></p>
        <p class="text-text-base mb-2"><a href="/fellows" class="hover:text-gray-600 transition-colors">Meet the Fellows</a></p>
        <div class="flex justify-end space-x-4">
          <a href="https://www.aisafetysa.com" target="_blank" rel="noopener noreferrer" class="flex items-center">
            <Image src={AissaLogo} alt="AISSA Logo" class="w-8 h-8" />
          </a>
          <a href="https://www.linkedin.com/company/ai-safety-south-africa/" target="_blank" rel="noopener noreferrer" class="text-[#0077B5] flex items-center">
            <Image src={LinkedInIcon} alt="LinkedIn" class="w-8 h-8" />
          </a>
          <a href="https://aisafetycapetown.substack.com/" target="_blank" rel="noopener noreferrer" class="text-[#FF6314] flex items-center">
            <Image src={SubstackIcon} alt="Substack" class="w-8 h-8" />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
