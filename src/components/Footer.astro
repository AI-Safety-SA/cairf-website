---
// Footer component
---

<footer class="bg-gray-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <!-- Left side - Logo -->
      <div class="flex items-center mb-6 md:mb-0">
        <div class="w-8 h-8 bg-orange-500 rounded-lg flex items-center justify-center mr-3">
          <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <span class="text-xl font-semibold">Cooperative AI</span>
      </div>
      
      <!-- Center - Partner logos -->
      <div class="flex items-center space-x-8 mb-6 md:mb-0">
        <div class="flex items-center">
          <div class="w-6 h-6 bg-gray-700 rounded-full mr-2"></div>
          <span class="text-sm text-gray-300">AI Initiative</span>
        </div>
        <div class="flex items-center">
          <div class="w-6 h-6 bg-gray-700 rounded-full mr-2"></div>
          <span class="text-sm text-gray-300">AI Safety South Africa</span>
        </div>
      </div>
      
      <!-- Right side - Copyright -->
      <div class="text-sm text-gray-400">
        © COPYRIGHT 2023
      </div>
    </div>
  </div>
</footer>
