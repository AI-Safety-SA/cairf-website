---
import { Image } from 'astro:assets';

import linkedInIcon from '../assets/icons/linkedin-brands-solid-full.svg'
import googleScholar from '../assets/icons/google-scholar-brands-solid-full.svg'
import globe from '../assets/icons/globe-solid-full.svg'

export interface Props {
  name: string;
  title: string;
  website?: string;
  linkedin?: string;
  academic?: string;
  image?: string;
}

const { 
  name, 
  title, 
  website,
  linkedin, 
  academic, 
  image 
} = Astro.props;
---

<div class="flex flex-col items-center text-center">
  <!-- Image placeholder -->
  <div class="w-72 h-72 bg-gray-200 rounded-lg mb-4 flex items-center justify-center overflow-hidden">
    <a href={website} target="_blank" rel="noopener noreferrer">
      {image ? (
        <img 
          src={image} 
          alt={name} 
          class="w-full h-full object-cover rounded-lg"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full bg-gray-300 rounded-lg flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
          </svg>
        </div>
      )}
      </a>
  </div>
  
  <!-- Name -->
  <h3 class="font-semibold text-text-base mb-2 text-base md:text-lg">{name}</h3>
  
  <!-- Social icons -->
  <div class="flex items-center justify-center space-x-2 mb-2">
    {website && (
      <a href={website} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-700 transition-colors">
        <Image src={globe} alt="Website" class="w-8 h-8" />
      </a>
    )}

    {linkedin && (
      <a href={linkedin} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-700 transition-colors">
        <Image src={linkedInIcon} alt="LinkedIn" class="w-8 h-8" />
      </a>
    )}
    
    {academic && (
      <a href={academic} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-700 transition-colors">
        <Image src={googleScholar} alt="GoogleScholar" class="w-8 h-8" />
      </a>
    )}
  </div>
  
  <!-- Title/Affiliation -->
  <p class="text-sm md:text-base text-text-muted leading-relaxed max-w-48">{title}</p>
</div>
