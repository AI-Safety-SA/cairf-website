---
// Reusable text section component
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  content: string | string[];
  position: 'left' | 'right';
  image: any; // Image import
  imageAlt?: string;
}

const { title, content, position, image, imageAlt = "Content illustration" } = Astro.props;
---

<div class="w-full">
  <!-- Mobile Layout: Image above text -->
  <div class="lg:hidden space-y-6">
    <div class="w-full h-64 rounded-lg overflow-hidden">
      <Image 
        src={image} 
        alt={imageAlt} 
        class="w-full h-full object-cover"
      />
    </div>
    
    <div class="bg-white p-12 rounded-lg shadow-lg">
      <h2 class="text-3xl md:text-4xl font-bold text-black mb-8">
        {title}
      </h2>
      
      {Array.isArray(content) ? (
        <div class="space-y-4">
          {content.map((paragraph) => (
            <p class="text-lg text-black leading-relaxed">
              {paragraph}
            </p>
          ))}
        </div>
      ) : (
        <p class="text-lg text-black leading-relaxed">
          {content}
        </p>
      )}
    </div>
  </div>

  <!-- Desktop Layout: Image and text side by side -->
  <div class="hidden lg:flex items-center min-h-96 gap-8 w-full">
    {position === 'left' ? (
      <>
        <div class="w-1/2 h-96 rounded-lg overflow-hidden">
          <Image 
            src={image} 
            alt={imageAlt} 
            class="w-full h-full object-cover"
          />
        </div>
        <div class="w-1/2 bg-white p-12 rounded-lg shadow-lg">
          <h2 class="text-3xl md:text-4xl font-bold text-black mb-8">
            {title}
          </h2>
          
          {Array.isArray(content) ? (
            <div class="space-y-4">
              {content.map((paragraph) => (
                <p class="text-lg text-black leading-relaxed">
                  {paragraph}
                </p>
              ))}
            </div>
          ) : (
            <p class="text-lg text-black leading-relaxed">
              {content}
            </p>
          )}
        </div>
      </>
    ) : (
      <>
        <div class="w-1/2 bg-white p-12 rounded-lg shadow-lg">
          <h2 class="text-3xl md:text-4xl font-bold text-black mb-8">
            {title}
          </h2>
          
          {Array.isArray(content) ? (
            <div class="space-y-4">
              {content.map((paragraph) => (
                <p class="text-lg text-black leading-relaxed">
                  {paragraph}
                </p>
              ))}
            </div>
          ) : (
            <p class="text-lg text-black leading-relaxed">
              {content}
            </p>
          )}
        </div>
        <div class="w-1/2 h-96 rounded-lg overflow-hidden">
          <Image 
            src={image} 
            alt={imageAlt} 
            class="w-full h-full object-cover"
          />
        </div>
      </>
    )}
  </div>
</div>
