---
// Partnerships section component
---

<section id="partners" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12">
      Partnerships
    </h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left side with content -->
      <div>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          The Cooperative AI South Africa Fellowship is made possible through strategic partnerships with leading organizations in the AI safety and research community.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed mb-6">
          Our partners provide expertise, resources, and mentorship to ensure fellows receive world-class training and support throughout their research journey.
        </p>
        <p class="text-lg text-gray-700 leading-relaxed">
          Together, we're building a global network of researchers committed to advancing cooperative AI and ensuring its safe and beneficial development.
        </p>
      </div>
      
      <!-- Right side with logos -->
      <div class="grid grid-cols-2 gap-8">
        <!-- Cooperative AI -->
        <div class="bg-gray-50 p-6 rounded-lg text-center">
          <div class="w-16 h-16 bg-orange-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900">Cooperative AI</h3>
        </div>
        
        <!-- AI Initiative -->
        <div class="bg-gray-50 p-6 rounded-lg text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-blue-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900">AI Initiative</h3>
        </div>
        
        <!-- AI Safety South Africa -->
        <div class="bg-gray-50 p-6 rounded-lg text-center">
          <div class="w-16 h-16 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-green-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900">AI Safety South Africa</h3>
        </div>
        
        <!-- Additional Partner -->
        <div class="bg-gray-50 p-6 rounded-lg text-center">
          <div class="w-16 h-16 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-purple-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3 class="font-semibold text-gray-900">Research Partner</h3>
        </div>
      </div>
    </div>
  </div>
</section>
