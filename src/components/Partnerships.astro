---
// Partnerships section component
import { Image } from 'astro:assets';
import CoopAILogo from '../assets/partner-logos/CoopAI_logo.png';
import PIBBSLogo from '../assets/partner-logos/PIBBS_logo.png';
import AIInitiativeLogo from '../assets/partner-logos/AI_Initiative_logo.png';
import AISSALogo from '../assets/partner-logos/AISSA_logo.svg';
---

<section id="partners" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12">
      Partners
    </h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Left column: Partners and description -->
      <div class="space-y-8">
        <div class="text-left">
          <p class="text-lg text-gray-700 leading-relaxed">
            The fellowship is a collaboration with the Cooperative AI Foundation, PIBBSS, The AI Initiative at UCT and AI Safety South Africa. We build on PIBBSS fellowship methodology with CAIF research oversight. This initiative serves as both a talent pipeline and research direction-setting mechanism for the University of Cape Town's emerging AI Safety Hub.
          </p>
        </div>
        
        <!-- Partner descriptions -->
        <div class="space-y-6">
          <div class="border-l-4 border-blue-500 pl-4">
            <h3 class="font-semibold text-gray-900 mb-2">Cooperative AI Foundation (CAIF)</h3>
            <p class="text-sm text-gray-600">A new charitable entity, backed by a $15 million philanthropic commitment from Macroscopic Ventures. CAIF's mission is to support research that will improve the cooperative intelligence of advanced AI for the benefit of all.</p>
          </div>
          
          <div class="border-l-4 border-green-500 pl-4">
            <h3 class="font-semibold text-gray-900 mb-2">UCT AI Initiative</h3>
            <p class="text-sm text-gray-600">Provides a rich ecosystem that enables researchers and students to do excellent AI research which will create tools and opportunities that facilitate the transition to a just society.</p>
          </div>
          
          <div class="border-l-4 border-purple-500 pl-4">
            <h3 class="font-semibold text-gray-900 mb-2">PIBBSS</h3>
            <p class="text-sm text-gray-600">Facilitates knowledge transfer from fields studying intelligence in natural systems toward building human-aligned AI.</p>
          </div>
          
          <div class="border-l-4 border-orange-500 pl-4">
            <h3 class="font-semibold text-gray-900 mb-2">AI Safety South Africa (AISSA)</h3>
            <p class="text-sm text-gray-600">A capacity building organisation focused on developing skills and community in South Africa through events, courses, and co-working at AI Safety Cape Town.</p>
          </div>
        </div>
      </div>
      
      <!-- Right column: Partner logos -->
      <div class="space-y-8">
        <!-- CoopAI logo -->
        <div class="bg-gray-50 p-6 rounded-lg text-center">
          <div class="mx-auto mb-4 flex items-center justify-center">
            <Image 
              src={CoopAILogo} 
              alt="Cooperative AI Foundation Logo" 
              class="max-w-full max-h-full object-contain"
              height={128}
            />
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">Cooperative AI Foundation (CAIF)</h3>
        </div>
        
        <!-- AI Initiative and PIBBSS logos -->
        <div class="grid grid-cols-2 gap-4">
          <!-- UCT AI Initiative -->
          <div class="bg-gray-50 p-4 rounded-lg text-center">
            <div class="mx-auto mb-3 flex items-center justify-center">
              <Image 
                src={AIInitiativeLogo} 
                alt="UCT AI Initiative Logo" 
                class="max-w-full max-h-full object-contain"
                height={96}
              />
            </div>
            <h3 class="font-semibold text-gray-900 text-sm">UCT AI Initiative</h3>
          </div>
          
          <!-- PIBBSS -->
          <div class="bg-gray-50 p-4 rounded-lg text-center">
            <div class="mx-auto mb-3 flex items-center justify-center">
              <Image 
                src={PIBBSLogo} 
                alt="PIBBSS Logo" 
                class="max-w-full max-h-full object-contain"
                height={96}
              />
            </div>
            <h3 class="font-semibold text-gray-900 text-sm">PIBBSS</h3>
          </div>
        </div>
        
        <!-- AISSA logo -->
        <div class="bg-gray-50 p-6 rounded-lg text-center">
          <div class="mx-auto mb-4 flex items-center justify-center">
            <Image 
              src={AISSALogo} 
              alt="AI Safety South Africa Logo" 
              class="max-w-full max-h-full object-contain"
              height={128}
            />
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">AI Safety South Africa (AISSA)</h3>
        </div>
      </div>
    </div>
  </div>
</section>
