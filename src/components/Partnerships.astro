---
// Partnerships section component 
import { Image } from 'astro:assets';
import CoopAILogo from '../assets/logos/CoopAI_Secondary_Foundation_Black_Web_Large.png';
import PIBBSLogo from '../assets/logos/pibbs_logo.jpg';
import AIInitiativeLogo from '../assets/logos/uct_ai_initiative_logo.svg';
import AISSALogo from '../assets/logos/aissa_logo_black_text.png';
import partnersApesDesktop from '../assets/images/partners-apes-desktop.jpg';
import partnersApesMobile from '../assets/images/partners-apes-mobile.jpg';

// Content data
const partnershipContent = {
  title: "Partners",
  intro: "The fellowship is a collaboration between the Cooperative AI Foundation (CAIF), Principles of Intelligent Behavior in Biological and Social Systems (PIBBSS), The AI Initiative at the University of Cape Town (UCT) and AI Safety South Africa (AISSA). AISSA is driving this project, and building on PIBBSS fellowship methodology with CAIF research oversight. This initiative serves as both a talent pipeline and research direction-setting mechanism for UCT's emerging African AI Safety Hub. This initiative is funded by the AI Safety Tactical Opportunities Fund and the Cooperative AI Foundation.",
  partners: [
    {
      name: "AI Safety South Africa (AISSA)",
      description: "A capacity building organisation focused on developing skills, networks, and community for preventing global catastrophic outcomes from advanced AI. AISSA drives impact through events, courses, partnerships and AI Safety Cape Town, a co-working and events space.",
      link: "https://www.aisafetysa.com/"
    },
    {
      name: "The Cooperative AI Foundation (CAIF)",
      description: "A charitable entity, backed by a $15 million philanthropic commitment from Macroscopic Ventures. CAIF's mission is to support research that will improve the cooperative intelligence of advanced AI for the benefit of all.",
      link: "https://www.cooperativeai.com/"
    },
    {
      name: "The UCT AI Initiative",
      description: "A research, teaching and knowledge translation ecosystem, dedicated to advancing world-class AI rooted in African realities. The initiative's mission is to design technologies that drive justice, dignity, and collective flourishing. The AI Initiative will have focus areas in AI applications including improving outcomes in health, climate, and poverty as well as AI safety and foundational AI theory.",
      link: "https://ai.uct.ac.za/"
    },
    {
      name: "Principles of Intelligent Behavior in Biological and Social Systems (PIBBSS)",
      description: "A research initiative aiming to leverage insights on the parallels between intelligent behaviour in natural and artificial systems towards progress on important questions in AI risk, governance and safety. PIBBSS has successfully run multiple research fellowships, developing a unique methodology for mentoring early-career researchers in AI safety.",
      link: "https://pibbss.ai/"
    }
  ]
};
---

<section id="partners">
  <!-- Desktop Partnerships Component -->
  <div class="hidden lg:block">
    <section class="relative min-h-screen">
      <div class="bg-surface text-text-base">
        <div class="flex flex-col lg:flex-row">
          <!-- Text Content -->
          <div class="w-full flex flex-col justify-around lg:w-3/5 px-4 sm:px-6 lg:pl-28 lg:pr-16 py-20">
            <h2 class="text-2xl md:text-3xl font-semibold mb-12">
              {partnershipContent.title}
            </h2>
            <div class="space-y-4">
              <p class="text-lg leading-relaxed">
                {partnershipContent.intro}
              </p>
            </div>
            
            <!-- Partner descriptions -->
            <div class="space-y-6 mt-8">
              {partnershipContent.partners.map((partner) => (
                <div>
                  <a href={partner.link} target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-600 text-lg font-medium">
                    <h3 class="font-semibold mb-2">
                      {partner.name}
                    </h3>
                  </a>
                  <p class="text-lg leading-relaxed">{partner.description}</p>
                </div>
              ))}
            </div>
          </div>
          
          <!-- Desktop Image Container -->
          <div class="w-full lg:w-2/5 relative">
            <Image 
              src={partnersApesDesktop} 
              alt="Partnership illustration featuring anthropomorphic monkeys in a natural landscape" 
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Mobile Partnerships Component -->
  <div class="lg:hidden">
    <section class="relative min-h-screen">
        <div class="bg-surface">
          <!-- Title and intro paragraph -->
          <div class="px-4 sm:px-6 py-20">
            <div class="px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl md:text-3xl font-semibold mb-12">
              {partnershipContent.title}
            </h2>
            <div class="space-y-4">
              <p class="text-lg leading-relaxed">
                {partnershipContent.intro}
              </p>
            </div>
            </div>
          </div>
          
          <!-- Mobile Image - Full width -->
          <div class="w-full">
            <Image 
              src={partnersApesMobile} 
              alt="Partnership illustration featuring anthropomorphic monkeys in a natural landscape" 
              class="w-full object-cover"
            />
          </div>
          
          <!-- Partner descriptions -->
          <div class="px-4 sm:px-6">
            <div class="px-4 sm:px-6 lg:px-8">
            <div class="space-y-6 mt-8">
              {partnershipContent.partners.map((partner) => (
                <div>
                  <a href={partner.link} target="_blank" rel="noopener noreferrer" class="underline hover:text-gray-600 text-lg font-medium">
                    <h3 class="font-semibold mb-2">{partner.name}</h3>
                  </a>
                  <p class="text-lg leading-relaxed">{partner.description}</p>
                  
                </div>
              ))}
            </div>
            </div>
          </div>
        </div>
    </section>
  </div>

  <!-- Logo banner at the bottom -->
  <div class="bg-surface py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Desktop layout: 4 logos in a row, evenly spaced -->
      <div class="hidden md:flex justify-between items-center gap-8">
        <Image 
          src={CoopAILogo} 
          alt="Cooperative AI Foundation Logo" 
          class="h-16 w-auto object-contain flex-1"
        />
        <Image 
          src={PIBBSLogo} 
          alt="PIBBSS Logo" 
          class="h-18 w-auto object-contain flex-1"
        />
        <Image 
          src={AIInitiativeLogo} 
          alt="UCT AI Initiative Logo" 
          class="h-16 w-auto object-contain flex-1"
        />
        <Image 
          src={AISSALogo} 
          alt="AI Safety South Africa Logo" 
          class="h-16 w-auto object-contain flex-1"
        />
      </div>
      
      <!-- Mobile layout: 3 rows with middle row having 2 logos -->
      <div class="md:hidden flex flex-col items-center gap-8">
        <!-- Row 1: CoopAI -->
        <div class="flex justify-center">
          <Image 
            src={CoopAILogo} 
            alt="Cooperative AI Foundation Logo" 
            class="h-16 w-auto object-contain"
          />
        </div>
        
        <!-- Row 2: PIBBSS and UCT AI Initiative -->
        <div class="flex justify-center items-center gap-8">
          <Image 
            src={PIBBSLogo} 
            alt="PIBBSS Logo" 
            class="h-18 w-auto object-contain"
          />
          <Image 
            src={AIInitiativeLogo} 
            alt="UCT AI Initiative Logo" 
            class="h-16 w-auto object-contain"
          />
        </div>
        
        <!-- Row 3: AISSA -->
        <div class="flex justify-center">
          <Image 
            src={AISSALogo} 
            alt="AI Safety South Africa Logo" 
            class="h-16 w-auto object-contain"
          />
        </div>
      </div>
    </div>
  </div>
</section>
