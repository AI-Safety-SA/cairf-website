---
// Application Process section component
---

<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12">
      Application Process
    </h2>
    
    <p class="text-lg text-gray-700 text-center mb-12">
      There will be a three-phase application process.
    </p>
    
    <div class="space-y-8">
      <!-- Phase 1 -->
      <div class="flex items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
          <span class="text-orange-600 font-bold text-lg">1</span>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Phase 1: Eligibility Screening</h3>
          <p class="text-gray-700">Covering CV, background in ML, programming experience, research interests, AI safety knowledge and career plans.</p>
        </div>
      </div>
      
      <!-- Phase 2 -->
      <div class="flex items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
          <span class="text-orange-600 font-bold text-lg">2</span>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Phase 2: Skills Assessment</h3>
          <p class="text-gray-700">Skills assessment on our evaluation platform.</p>
        </div>
      </div>
      
      <!-- Phase 3 -->
      <div class="flex items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
          <span class="text-orange-600 font-bold text-lg">3</span>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Phase 3: Interview</h3>
          <p class="text-gray-700">Final interview with the selection committee.</p>
        </div>
      </div>
    </div>
    
    <div class="mt-12 p-6 bg-yellow-50 rounded-lg">
      <p class="text-gray-700 text-center">
        We value inclusion and encourage applicants from diverse backgrounds. Please contact us if you require special accommodation in order to apply.
      </p>
    </div>
  </div>
</section>
