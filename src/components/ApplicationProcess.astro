---
// Application Process section component
---

<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12">
      Application Process
    </h2>
    
    <div class="space-y-8">
      <!-- Step 1 -->
      <div class="flex items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
          <span class="text-orange-600 font-bold text-lg">1</span>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Online application form</h3>
          <p class="text-gray-700">Complete our comprehensive online application form, including your research interests, academic background, and motivation for joining the fellowship.</p>
        </div>
      </div>
      
      <!-- Step 2 -->
      <div class="flex items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
          <span class="text-orange-600 font-bold text-lg">2</span>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Shortlisting and interviews</h3>
          <p class="text-gray-700">Successful candidates will be shortlisted and invited for technical interviews with our research team and potential mentors.</p>
        </div>
      </div>
      
      <!-- Step 3 -->
      <div class="flex items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
          <span class="text-orange-600 font-bold text-lg">3</span>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Offer and acceptance</h3>
          <p class="text-gray-700">Selected fellows will receive formal offers with detailed program information and will have time to review and accept their positions.</p>
        </div>
      </div>
      
      <!-- Step 4 -->
      <div class="flex items-start">
        <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
          <span class="text-orange-600 font-bold text-lg">4</span>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Visa and travel arrangements</h3>
          <p class="text-gray-700">Our team will assist international fellows with visa applications, travel arrangements, and accommodation setup in Cape Town.</p>
        </div>
      </div>
    </div>
  </div>
</section>
