---
// Application Process section component
import { Image } from 'astro:assets';
import dummyImage from '../assets/dummy_image.png';
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left side with content -->
              <div class="bg-yellow p-8 rounded-lg">
          <h2 class="text-3xl md:text-4xl font-bold text-text-base mb-8">
            Application Process
          </h2>
          
          <p class="text-lg text-text-muted mb-8">
          There will be a three-phase application process.
        </p>
        
        <div class="space-y-8">
          <!-- Phase 1 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
              <span class="text-orange-600 font-bold text-lg">1</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-text-base mb-2">Phase 1: Eligibility Screening</h3>
                              <p class="text-text-muted">Covering CV, background in ML, programming experience, research interests, AI safety knowledge and career plans.</p>
            </div>
          </div>
          
          <!-- Phase 2 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
              <span class="text-orange-600 font-bold text-lg">2</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-text-base mb-2">Phase 2: Skills Assessment</h3>
                              <p class="text-text-muted">Skills assessment on our evaluation platform.</p>
            </div>
          </div>
          
          <!-- Phase 3 -->
          <div class="flex items-start">
            <div class="flex-shrink-0 w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mr-6">
              <span class="text-orange-600 font-bold text-lg">3</span>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-text-base mb-2">Phase 3: Interview</h3>
                              <p class="text-text-muted">Final interview with the selection committee.</p>
            </div>
          </div>
        </div>
        
                  <div class="mt-8 p-6 bg-surface rounded-lg">
          <p class="text-text-muted text-center">
            We value inclusion and encourage applicants from diverse backgrounds. Please contact us if you require special accommodation in order to apply.
          </p>
        </div>
      </div>
      
      <!-- Right side with placeholder panel -->
              <div class="bg-surface-alt h-96 rounded-lg overflow-hidden">
        <Image 
          src={dummyImage} 
          alt="Abstract textured surface" 
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
