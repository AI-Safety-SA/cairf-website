---
import FAQItem from './FAQItem.astro';
import ApplyButton from './ApplyButton.astro';

// FAQ data
const faqData = [
  {
    question: "How does mentor matching work?",
    answer: "Each fellow will be matched with an expert mentor, who will provide in-person feedback on their project. In addition, fellows will be guided by a research manager who will facilitate their research process and connect them to relevant resources during weekly meetings."
  },
  {
    question: "Who is eligible?",
    answer: "Students and early career researchers who can make an impactful contribution to the field of cooperative AI. Early career researchers interested in applying their skills to AI Safety with a background in machine learning, MARL, Game Theory, complex systems or Math are preferred."
  },
  {
    question: "Where will fellows work?",
    answer: "At the AI Safety Cape Town co-working space."
  },
  {
    question: "What is offered?",
    answer: "Fellows will receive mentorship, access to a global AI safety research community and a stipend covering housing and living expenses."
  },
  {
    question: "Can I participate part time/remotely?",
    answer: "We are unable to accommodate part time participation. This is a full time, in-person opportunity."
  },
  {
    question: "Can I refer someone?",
    answer: "Yes! Please make use of our referral form here."
  },
  {
    question: "What if I am new to AI safety?",
    answer: "We care about your intent to make an impact and as such will offer an introduction to the field during our onboarding process, including readings prior to the start of the in-person course."
  },
  {
    question: "What will I work on if selected?",
    answer: "Research will focus on the interactions that emerge in multi-agent AI systems and their relationship with humans and human systems."
  },
  {
    question: "What can I gain from the fellowship?",
    answer: [
      "1. Publish a research project that makes an impactful contribution to cooperative AI, reducing global catastrophic risk.",
      "2. There is the possibility of an ongoing research position at the University of Cape Town AI Initiative.",
      "3. Promotion of talent to global AI safety initiatives."
    ]
  }
];
---

<section id="faq" class="py-20 bg-green-dark">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-12">
      Frequently Asked Questions
    </h2>
    
    <div class="space-y-0">
      {faqData.map((faq, index) => (
        <FAQItem question={faq.question} answer={faq.answer} isLast={index === faqData.length - 1} />
      ))}
    </div>
    
    <!-- Contact information -->
    <div class="mt-12 text-center">
      <p class="text-white mb-4">If you have further questions, please reach out to us at contact@caisaf.org.</p>
    </div>
    
    <!-- Apply button at bottom right -->
    <div class="flex justify-center mt-8">
      <ApplyButton />
    </div>
  </div>
</section>
