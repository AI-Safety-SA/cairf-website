---
import ApplyButton from './ApplyButton.astro';

// ContentSection component - reusable layout for content sections
export interface Props {
  backgroundColor?: string;
}

const { 
  backgroundColor = "bg-surface"
} = Astro.props;
---

<div class={`max-w-7xl mx-auto px-4 py-20 ${backgroundColor}`}>
  <div class="flex flex-col items-center">
    <div class="max-w-4xl space-y-8 px-8 lg:px-12 text-left">
      <!-- Slot for the main content -->
      <slot />
      
      <div class="mt-12 flex justify-center">
        <ApplyButton variant='primary' size='lg'/>
      </div>
    </div>
  </div>
</div>

