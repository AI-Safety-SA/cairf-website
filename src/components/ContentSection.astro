---
// ContentSection component - reusable layout for content sections
export interface Props {
  id?: string;
  backgroundColor?: string;
  className?: string;
}

const { 
  id = "",
  backgroundColor = "bg-surface",
  className = ""
} = Astro.props;
---

<section id={id} class={`py-20 ${backgroundColor} ${className}`}>
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col items-center">
      <div class="max-w-4xl space-y-8 px-8 lg:px-12 text-left">
        <!-- Slot for the main content -->
        <slot />
        
        <!-- Apply button - consistent across all sections -->
        <div class="pt-4 flex justify-center md:justify-end">
          <div class="hidden md:block">
            <a href="#apply" class="inline-block bg-primary hover:bg-primary/90 text-white font-semibold px-8 py-4 text-lg rounded transition-colors duration-200">
              APPLY NOW
            </a>
          </div>
          <div class="block md:hidden">
            <a href="#apply" class="inline-block bg-primary hover:bg-primary/90 text-white font-semibold px-6 py-3 text-base rounded transition-colors duration-200">
              APPLY NOW
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
