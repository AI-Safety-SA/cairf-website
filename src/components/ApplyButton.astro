---
interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
}

const { 
  variant = 'primary', 
  size = 'md',
  href = 'https://tally.so/r/wdMr7K'
} = Astro.props;

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
};

const variantClasses = {
  primary: 'bg-primary/70 text-white cursor-not-allowed border-primary/70 px-8 py-2.5 text-xl',
  secondary: 'bg-white/70 text-primary/70 cursor-not-allowed border-primary/70 px-8 py-1.5 text-lg',
};

const variantText = {
  primary: 'APPLICATIONS CLOSED',
  secondary: 'APPLICATIONS CLOSED'
};

const finalVariant = variantClasses[variant]
const finalText = variantText[variant]

---

<span 
  class={`
    inline-block
    font-sans
    font-extrabold
    rounded-sm
    border-1
    transition-all 
    duration-200
    ${finalVariant}
  `}
>
  {finalText}
</span>