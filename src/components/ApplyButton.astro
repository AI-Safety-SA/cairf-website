---
interface Props {
  variant?: 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
}

const { 
  variant = 'primary', 
  size = 'md',
  href = 'https://tally.so/r/wdMr7K'
} = Astro.props;

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
};

const variantClasses = {
  primary: 'bg-primary text-white hover:bg-primary/90 border-primary px-8 py-2.5 text-xl',
  secondary: 'bg-white text-primary border-primary hover:bg-primary/10 px-8 py-1.5 text-lg',
};

const variantText = {
  primary: 'APPLY NOW',
  secondary: 'APPLY'
};

const finalVariant = variantClasses[variant]
const finalText = variantText[variant]

---

<a 
  href={href} 
  target="_blank"
  rel="noopener noreferrer"
  class={`
    inline-block
    font-sans
    font-extrabold
    rounded-sm
    border-1
    transition-all 
    duration-200
    hover:shadow-lg
    ${finalVariant}
  `}
>
  {finalText}
</a>