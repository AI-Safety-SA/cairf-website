---
interface Props {
  variant?: 'primary' | 'secondary' | 'mobile' | 'desktop';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
}

const { 
  variant = 'primary', 
  size = 'md',
  href = 'https://tally.so/r/wdMr7K'
} = Astro.props;

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
};

const variantClasses = {
  primary: 'bg-primary text-white hover:bg-primary/90 border-primary',
  secondary: 'bg-white text-primary border-primary hover:bg-primary/10',
  mobile: 'bg-primary text-white hover:bg-primary/90 border-primary px-6 py-3 text-base',
  desktop: 'bg-primary text-white hover:bg-primary/90 border-primary px-8 py-4 text-lg'
};

const variantText = {
  primary: 'APPLY NOW',
  secondary: 'APPLY'
};

// Handle legacy variants
const isLegacyVariant = variant === 'mobile' || variant === 'desktop';
const finalSize = isLegacyVariant ? '' : sizeClasses[size];
const finalVariant = isLegacyVariant ? variantClasses[variant] : variantClasses[variant];

const finalVariantText = isLegacyVariant ? 'APPLY NOW' : variantText[variant];
---

<a 
  href={href} 
  target="_blank"
  rel="noopener noreferrer"
  class={`
    inline-block 
    px-6 py-3 text-lg
    font-semibold 
    rounded 
    border-2 
    transition-all 
    duration-200 
    hover:scale-105 
    hover:shadow-lg
    ${isLegacyVariant ? '' : finalSize}
    ${finalVariant}
  `}
>
  {finalVariantText}
</a>