---
// About section component
import { Image } from 'astro:assets';
import aboutImage from '../assets/about_image.png';
import ContentSection from './ContentSection.astro';
---

<ContentSection id="about" backgroundColor="bg-surface">
  <h2 class="text-3xl md:text-4xl font-bold text-text-base">
    About The Fellowship
  </h2>
  
  <div class="space-y-6 text-text-base">
    <p class="text-lg leading-relaxed">
      Participants from around the world will pursue cooperative AI research for 3 months from January - April 2026. The fellowship kicks off with a week-long retreat and culminates with a conference.
    </p>
    
    <p class="text-lg leading-relaxed">
      Fellows will work with collaborators from partner organisations such as the Cooperative AI Foundation (CAIF), Principles of Intelligent Behavior in Biological and Social Systems (PIBBSS) and The University of Cape Town (UCT) AI Initiative.
    </p>
    
    <p class="text-lg leading-relaxed">
      Participants will receive 1:1 mentorship from top researchers in the field of cooperative AI, resources for building knowledge in AI safety and comprehensive financial support covering their living and travel expenses while in Cape Town. There will be opportunities for collaboration with other cohort members, a week-long retreat, workshops and access to the AI Safety Cape Town co-working space.
    </p>
  </div>
</ContentSection>
