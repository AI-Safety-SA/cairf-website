---
// About section component
---

<section id="about" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left side with content -->
      <div class="bg-yellow-50 p-8 rounded-lg">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
          About the Cooperative AI South Africa Fellowship
        </h2>
        
        <div class="space-y-6 text-gray-700">
          <p class="text-lg leading-relaxed">
            The Cooperative AI South Africa Fellowship is a 6-month research project for talented South African researchers to explore how to ensure that future AI systems are cooperative and beneficial to humanity.
          </p>
          
          <p class="text-lg leading-relaxed">
            Fellows will work on a research project, receive mentorship from leading researchers in cooperative AI, and participate in workshops and events to support their research and career development.
          </p>
          
          <p class="text-lg leading-relaxed">
            The fellowship aims to build a community of researchers in South Africa working on cooperative AI, contribute to the global understanding of cooperative AI, and support the development of safe and beneficial AI in Africa.
          </p>
        </div>
      </div>
      
      <!-- Right side with placeholder panel -->
      <div class="bg-gray-100 h-96 rounded-lg flex items-center justify-center">
        <div class="text-center">
          <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <p class="text-gray-500 font-medium">Placeholder Panel</p>
        </div>
      </div>
    </div>
    
    <!-- Apply button centered at bottom -->
    <div class="text-center mt-12">
      <a href="#apply" class="inline-block bg-orange-500 hover:bg-orange-600 text-white px-8 py-4 rounded-md text-lg font-semibold transition-colors duration-200">
        APPLY NOW
      </a>
    </div>
  </div>
</section>
