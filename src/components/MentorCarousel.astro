---
// MentorCarousel component for displaying mentors in a carousel
import { Image } from 'astro:assets';

import linkedInIcon from '../assets/icons/linkedin-brands-solid-full.svg'
import googleScholar from '../assets/icons/google-scholar-brands-solid-full.svg'
import globe from '../assets/icons/globe-solid-full.svg'
import twitterIcon from '../assets/icons/x-twitter-brands-solid-full.svg'

import type { Props as MentorItemProps } from './MentorItem.astro';

export interface Props {
  mentors: MentorItemProps[];
}

const { mentors } = Astro.props;
const itemsPerView = 4;
const maxIndex = Math.max(0, mentors.length - itemsPerView);
---

<div class="mentor-carousel relative" data-max-index={maxIndex} data-total-mentors={mentors.length}>
  <!-- Carousel Container -->
  <div class="overflow-hidden">
    <div 
      class="flex gap-8 transition-transform duration-300 ease-in-out"
      id="carousel-track"
    >
      {mentors.map((mentor, index) => (
        <div class="flex-shrink-0" style="width: calc(25% - 1.5rem);">
          <div class="flex flex-col items-center text-center">
            <!-- Image placeholder -->
            <div class="w-64 h-64 bg-gray-200 rounded-lg mb-4 flex items-center justify-center overflow-hidden">
              <a href={mentor.website} target="_blank" rel="noopener noreferrer">
                {mentor.image ? (
                  <img 
                    src={mentor.image} 
                    alt={mentor.name} 
                    class="w-full h-full object-cover rounded-lg"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-gray-300 rounded-lg flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
                    </svg>
                  </div>
                )}
              </a>
            </div>
            
            <!-- Name -->
            <h3 class="font-semibold text-text-base mb-2 text-base md:text-lg">
              {mentor.name}
            </h3>
            
            <!-- Social icons -->
            <div class="flex items-center justify-center space-x-2 mb-2">

              {mentor.website && (
                <a href={mentor.website} target="_blank" rel="noopener noreferrer">
                  <Image src={globe} alt="Website" class="w-6 h-6" />
                </a>
              )}

              {mentor.linkedin && (
                <a href={mentor.linkedin} target="_blank" rel="noopener noreferrer">
                  <Image src={linkedInIcon} alt="LinkedIn" class="w-6 h-6" />
                </a>
              )}
              
              {mentor.twitter && (
                <a href={mentor.twitter} target="_blank" rel="noopener noreferrer">
                  <Image src={twitterIcon} alt="X-Twitter" class="w-6 h-6" />
                </a>
              )}
              
              {mentor.academic && (
                <a href={mentor.academic} target="_blank" rel="noopener noreferrer">
                  <Image src={googleScholar} alt="Google Scholar" class="w-6 h-6" />
                </a>
              )}

            </div>
            
            <!-- Title/Affiliation -->
            <p class="text-sm md:text-base text-text-muted leading-relaxed max-w-48">
              {mentor.title}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Navigation Arrows -->
  <button
    class="carousel-prev absolute left-0 top-1/2 -translate-y-1/2 -translate-x-12 bg-white hover:bg-gray-50 text-gray-600 hover:text-gray-800 rounded-full p-3 shadow-lg border border-gray-200 transition-all duration-200 z-10"
    aria-label="Previous mentors"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button
    class="carousel-next absolute right-0 top-1/2 -translate-y-1/2 translate-x-12 bg-white hover:bg-gray-50 text-gray-600 hover:text-gray-800 rounded-full p-3 shadow-lg border border-gray-200 transition-all duration-200 z-10"
    aria-label="Next mentors"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Dots Indicator -->
  {maxIndex > 0 && (
    <div class="flex justify-center mt-8 space-x-2">
      {Array.from({ length: maxIndex + 1 }, (_, index) => (
        <button
          class={`carousel-dot w-3 h-3 rounded-full transition-all duration-200 ${
            index === 0 
              ? 'bg-primary' 
              : 'bg-gray-300 hover:bg-gray-400'
          }`}
          data-slide={index}
          aria-label={`Go to slide ${index + 1}`}
        />
      ))}
    </div>
  )}
</div>

<script>
  // Carousel functionality
  document.addEventListener('DOMContentLoaded', function() {
    const carousels = document.querySelectorAll('.mentor-carousel');
    
    carousels.forEach(carousel => {
      const track = carousel.querySelector('#carousel-track') as HTMLElement;
      const prevBtn = carousel.querySelector('.carousel-prev') as HTMLButtonElement;
      const nextBtn = carousel.querySelector('.carousel-next') as HTMLButtonElement;
      const dots = carousel.querySelectorAll('.carousel-dot') as NodeListOf<HTMLButtonElement>;
      const maxIndex = parseInt(carousel.getAttribute('data-max-index') || '0');
      const totalMentors = parseInt(carousel.getAttribute('data-total-mentors') || '0');
      
      let currentIndex = 0;
      
      function updateCarousel() {
        if (track) {
          // Calculate the translation based on the current index
          // Each item takes up 25% of the container width plus gap
          const itemWidth = 25; // 25% width
          const gapWidth = 2; // 2rem gap = 2% of container
          const translateX = currentIndex * (itemWidth + gapWidth);
          track.style.transform = `translateX(-${translateX}%)`;
        }
        
        // Update dots
        dots.forEach((dot, index) => {
          if (index === currentIndex) {
            dot.classList.remove('bg-gray-300', 'hover:bg-gray-400');
            dot.classList.add('bg-primary');
          } else {
            dot.classList.remove('bg-primary');
            dot.classList.add('bg-gray-300', 'hover:bg-gray-400');
          }
        });
      }
      
      // Next button
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          currentIndex = currentIndex >= maxIndex ? 0 : currentIndex + 1;
          updateCarousel();
        });
      }
      
      // Previous button
      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          currentIndex = currentIndex <= 0 ? maxIndex : currentIndex - 1;
          updateCarousel();
        });
      }
      
      // Dot navigation
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          currentIndex = index;
          updateCarousel();
        });
      });
    });
  });
</script>
