---
import type { FellowRecord } from '../lib/fellows';

export interface Props {
  fellow: FellowRecord;
}

const { fellow } = Astro.props;
const previewText = fellow.bio || fellow.researchInterests || fellow.projectProposal || '';
---

<article class="rounded-2xl border border-surface-alt bg-white shadow-sm overflow-hidden h-full flex flex-col">
  <div class="aspect-[4/3] bg-surface-alt overflow-hidden">
    {fellow.primaryImage ? (
      <img
        src={fellow.primaryImage}
        alt={`Portrait of ${fellow.name}`}
        class="w-full h-full object-cover"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-text-muted text-sm">No image available</div>
    )}
  </div>

  <div class="p-5 flex flex-col gap-3 flex-1">
    <h3 class="text-lg font-semibold text-text-base leading-tight">{fellow.name}</h3>

    <p class="text-sm leading-relaxed text-text-muted fellow-preview-clamp">{previewText}</p>

    <details class="group mt-auto pt-2 border-t border-surface-alt">
      <summary class="cursor-pointer text-sm font-semibold text-primary list-none">
        <span class="group-open:hidden">Read more</span>
        <span class="hidden group-open:inline">Show less</span>
      </summary>
      <div class="mt-3 space-y-3 text-sm leading-relaxed text-text-base whitespace-pre-line">
        {fellow.bio && (
          <div>
            <h4 class="text-xs uppercase tracking-wide text-text-muted font-semibold mb-1">Bio</h4>
            <p>{fellow.bio}</p>
          </div>
        )}
        {fellow.researchInterests && (
          <div>
            <h4 class="text-xs uppercase tracking-wide text-text-muted font-semibold mb-1">Research Interest</h4>
            <p>{fellow.researchInterests}</p>
          </div>
        )}
        {fellow.projectProposal && (
          <div>
            <h4 class="text-xs uppercase tracking-wide text-text-muted font-semibold mb-1">Project Proposal</h4>
            <p>{fellow.projectProposal}</p>
          </div>
        )}
        {fellow.mentors && (
          <div>
            <h4 class="text-xs uppercase tracking-wide text-text-muted font-semibold mb-1">Mentors</h4>
            <p>{fellow.mentors}</p>
          </div>
        )}
        {!fellow.bio && !fellow.researchInterests && !fellow.projectProposal && <p>{previewText}</p>}
      </div>
    </details>
  </div>
</article>
