---
// Mentorship section component
import MentorItem from './MentorItem.astro';
import MentorCarousel from './MentorCarousel.astro';
import ApplyButton from './ApplyButton.astro';
import { loadMentors } from '../lib/mentors';

const mentors = loadMentors();
---

<section id="mentorship" class="bg-surface text-text-base">
  <div class="max-w-7xl mx-auto py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-left mb-12">
        <h2 class="text-2xl md:text-3xl font-semibold mb-12">
          Mentorship
        </h2>
        
        <p class="text-lg leading-relaxed mb-8">
          Each fellow will be matched with an expert mentor, who will provide supervision for the duration of the fellowship. In addition, fellows will be supported by a research manager who will provide general research advice, career coaching, and ensure they are on track to meet their goals.
        </p>
        
        <p class="text-lg font-semibold leading-relaxed mb-8">
          We have gathered some truly world-class mentors for this fellowship, and expect more to join in the coming weeks. Prospective mentors include:
        </p>
      </div>
      
      <!-- Mentors Carousel (Desktop) and Grid (Mobile) -->
      <div class="mb-12">
        <!-- Desktop Carousel -->
        <div class="hidden lg:block">
          <MentorCarousel mentors={mentors} />
        </div>
        
        <!-- Mobile Grid -->
        <div class="lg:hidden grid grid-cols-1 md:grid-cols-2 gap-8">
          {mentors.map((mentor) => (
            <MentorItem 
              name={mentor.name}
              title={mentor.title}
              website={mentor.website}
              linkedin={mentor.linkedin}
              twitter={mentor.twitter}
              academic={mentor.academic}
              image={mentor.image}
            />
          ))}
        </div>
      </div>
      
      <!-- Apply Button -->
      <div class="flex justify-center md:justify-end">
        <ApplyButton variant='primary' />
      </div>
    </div>
  </div>
</section>
