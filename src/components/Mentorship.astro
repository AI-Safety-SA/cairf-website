---
// Mentorship section component
import MentorItem from './MentorItem.astro';
import MentorCarousel from './MentorCarousel.astro';
import fs from 'fs';
import path from 'path';
import ApplyButton from './ApplyButton.astro';

// Load mentor data from the JSON file generated by fetch-notion script
let mentors: any[] = [];
try {
  const mentorsPath = path.join(process.cwd(), 'src/assets/mentors/mentors.json');
  if (fs.existsSync(mentorsPath)) {
    const mentorsData = fs.readFileSync(mentorsPath, 'utf-8');
    mentors = JSON.parse(mentorsData);
  }
} catch (error) {
  console.warn('Could not load mentors data:', error);
  // Fallback to empty array if file doesn't exist
  mentors = [];
}

// Helper function to get the correct image path for a mentor
function getMentorImagePath(mentor: any): string | undefined {
  if (!mentor.image) return undefined;
  
  // The image path from the JSON is relative to the mentors directory
  // We need to make it relative to the public directory for the browser
  return `/mentors/images/${path.basename(mentor.image)}`;
}

// Process mentors data for the carousel
const processedMentors = mentors.map(mentor => ({
  ...mentor,
  image: getMentorImagePath(mentor)
}));
---

<section id="mentorship" class="py-16 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <!-- Section Header -->
      <div class="text-left mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-text-base mb-6">
          Mentorship
        </h2>
        
        <p class="text-lg text-text-muted leading-relaxed mb-8">
          Each fellow will be matched with an expert mentor, who will provide supervision for the duration of the fellowship. In addition, fellows will be supported by a research manager who will provide general research advice, career coaching, and ensure they are on track to meet their goals.
        </p>
        
        <h3 class="text-xl font-semibold text-text-base mb-8">
          Our mentors include:
        </h3>
      </div>
      
      <!-- Mentors Carousel (Desktop) and Grid (Mobile) -->
      <div class="mb-12">
        <!-- Desktop Carousel -->
        <div class="hidden lg:block">
          <MentorCarousel mentors={processedMentors} />
        </div>
        
        <!-- Mobile Grid -->
        <div class="lg:hidden grid grid-cols-1 md:grid-cols-2 gap-8">
          {processedMentors.map((mentor) => (
            <MentorItem 
              name={mentor.name}
              title={mentor.title}
              website={mentor.website}
              linkedin={mentor.linkedin}
              twitter={mentor.twitter}
              academic={mentor.academic}
              image={mentor.image}
            />
          ))}
        </div>
      </div>
      
      <!-- Apply Button -->
      <div class="flex justify-center md:justify-end">
        <ApplyButton variant='primary' size='lg' />
      </div>
    </div>
  </div>
</section>
