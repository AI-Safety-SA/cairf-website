---
// Timeline data
const timelineData = {
  applications: [
    { date: "26 August", description: "Phase 1 applications open." },
    { date: "18 September", description: "Info session webinar." },
    { date: "1 October", description: "Phase 1 applications close." },
    { date: "6 October", description: "Applicants proceed to the skills test phase." },
    { date: "20 October", description: "Applicants proceed to the interview phase." },
    { date: "29 October", description: "Fellows will be matched with mentors." },
    { date: "29 October - 13th November", description: "Interviews with mentors and final offers." }
  ],
  fellowship: [
    { date: "31 January", description: "Kickoff retreat in Cape Town." },
    { date: "9 February", description: "Research phase begins." },
    { date: "February", description: "Research continues." },
    { date: "March", description: "Research continues." },
    { date: "30 April", description: "Fellowship Conclusion." }
  ]
};
---

<section id="timeline" class="py-20 bg-green-dark text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 font-sans font-light">
    <h2 class="text-2xl md:text-3xl font-semibold mb-12 text-left">
      Timeline
    </h2>
    
    <!-- Desktop Timeline (Horizontal) -->
    <div class="hidden lg:block">
      <!-- 2025 - Applications Section -->
      <div class="mb-16">
        <h3 class="text-2xl font-regular mb-6">
          2025 - Applications
        </h3>
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute top-8 left-0 right-0 h-0.5 bg-white"></div>
          
          <div class="flex justify-between items-start">
            {timelineData.applications.map((item) => (
              <div class="flex flex-col items-center">
                <div class="w-0.5 h-4 bg-white mb-2 mt-8"></div>
                <div class="text-white font-semibold mb-2 text-center">{item.date}</div>
                <div class="text-white text-sm max-w-36 text-center">{item.description}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <!-- 2026 - Fellowship Section -->
      <div>
        <h3 class="text-2xl font-regular mb-6">
          2026 - Fellowship
        </h3>
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute top-8 left-0 right-0 h-0.5 bg-white"></div>
          
          <div class="flex justify-between items-start">
            {timelineData.fellowship.map((item) => (
              <div class="flex flex-col items-center">
                <div class="w-0.5 h-4 bg-white mb-2 mt-8"></div>
                <div class="text-white font-bold mb-2">{item.date}</div>
                <div class="text-white text-sm max-w-40 text-center">{item.description}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    
    <!-- Mobile Timeline (Vertical) -->
    <div class="lg:hidden">
      <!-- 2025 - Applications Section -->
      <div class="mb-12">
        <h3 class="text-xl font-bold text-white text-left mb-8">2025 - Applications</h3>
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute left-1/8 transform -translate-x-1/2 w-0.5 bg-white h-full top-0"></div>
          
          <div class="space-y-12 pt-4">
            {timelineData.applications.map((item, index) => (
              <div class="flex">
                <!-- Timeline dot -->
                <div class="w-1/4 relative">
                  <div class="absolute left-1/2 transform -translate-x-1/2 w-3 h-3 bg-white rounded-full top-0"></div>
                </div>
                
                <!-- Content -->
                <div class="w-3/4 pl-6">
                  <h5 class="text-white font-bold text-sm mb-3">{item.date}</h5>
                  <div class="text-white text-sm leading-relaxed">{item.description}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
      
      <!-- 2026 - Fellowship Section -->
      <div>
        <h3 class="text-xl font-bold text-white text-left mb-8">2026 - Fellowship</h3>
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute left-1/8 transform -translate-x-1/2 w-0.5 bg-white h-full top-0"></div>
          
          <div class="space-y-12 pt-4">
            {timelineData.fellowship.map((item, index) => (
              <div class="flex">
                <!-- Timeline dot -->
                <div class="w-1/4 relative">
                  <div class="absolute left-1/2 transform -translate-x-1/2 w-3 h-3 bg-white rounded-full top-0"></div>
                </div>
                
                <!-- Content -->
                <div class="w-3/4 pl-6">
                  <h5 class="text-white font-bold text-sm mb-3">{item.date}</h5>
                  <div class="text-white text-sm leading-relaxed">{item.description}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
