---
// Timeline section component
---

<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12">
      Timeline
    </h2>
    
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-1/2 transform -translate-x-1/2 w-1 bg-orange-200 h-full"></div>
      
      <div class="space-y-12">
        <!-- 19 August 2025 - Applications open -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8 text-right">
            <h3 class="text-xl font-semibold text-gray-900">19 August 2025</h3>
            <p class="text-gray-600">Applications open</p>
          </div>
          <div class="w-1/2 pl-8"></div>
        </div>
        
        <!-- 18 September 2025 - Info session webinar -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8"></div>
          <div class="w-1/2 pl-8">
            <h3 class="text-xl font-semibold text-gray-900">18 September 2025</h3>
            <p class="text-gray-600">Info session webinar</p>
          </div>
        </div>
        
        <!-- 28 September 2025 - Applications close -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8 text-right">
            <h3 class="text-xl font-semibold text-gray-900">28 September 2025</h3>
            <p class="text-gray-600">Applications close</p>
          </div>
          <div class="w-1/2 pl-8"></div>
        </div>
        
        <!-- 6 October 2025 - Phase 1 acceptance -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8"></div>
          <div class="w-1/2 pl-8">
            <h3 class="text-xl font-semibold text-gray-900">6 October 2025</h3>
            <p class="text-gray-600">Phase 1 acceptance sent. Applicants proceed to the skills test phase</p>
          </div>
        </div>
        
        <!-- 20 October 2025 - Phase 2 acceptance -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8 text-right">
            <h3 class="text-xl font-semibold text-gray-900">20 October 2025</h3>
            <p class="text-gray-600">Phase 2 acceptance sent. Applicants proceed to the interview phase</p>
          </div>
          <div class="w-1/2 pl-8"></div>
        </div>
        
        <!-- 29 October 2025 - Final decision -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8"></div>
          <div class="w-1/2 pl-8">
            <h3 class="text-xl font-semibold text-gray-900">29 October 2025</h3>
            <p class="text-gray-600">Final decision on participants. Fellows to be matched with research managers and mentors</p>
          </div>
        </div>
        
        <!-- 10 January 2026 - Kickoff retreat -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8 text-right">
            <h3 class="text-xl font-semibold text-gray-900">10 January 2026</h3>
            <p class="text-gray-600">Kickoff retreat in Cape Town. Fellowship research phase commences</p>
          </div>
          <div class="w-1/2 pl-8"></div>
        </div>
        
        <!-- February and March 2026 - Research phase -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8"></div>
          <div class="w-1/2 pl-8">
            <h3 class="text-xl font-semibold text-gray-900">February and March 2026</h3>
            <p class="text-gray-600">Individual research projects begin, featuring regular mentor check-ins and weekly cohort discussion sessions</p>
          </div>
        </div>
        
        <!-- 13 April 2026 - Research completion -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8 text-right">
            <h3 class="text-xl font-semibold text-gray-900">13 April 2026</h3>
            <p class="text-gray-600">Research is completed and published. Fellows give final presentations at the Cape Town AI Safety Conference</p>
          </div>
          <div class="w-1/2 pl-8"></div>
        </div>
      </div>
    </div>
  </div>
</section>
