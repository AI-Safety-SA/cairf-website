---
// Timeline section component
---

<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12">
      Timeline
    </h2>
    
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-1/2 transform -translate-x-1/2 w-1 bg-orange-200 h-full"></div>
      
      <div class="space-y-12">
        <!-- 15 Oct - Application close -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8 text-right">
            <h3 class="text-xl font-semibold text-gray-900">15 Oct</h3>
            <p class="text-gray-600">Application close</p>
          </div>
          <div class="w-1/2 pl-8"></div>
        </div>
        
        <!-- 1 Nov - Shortlisting -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8"></div>
          <div class="w-1/2 pl-8">
            <h3 class="text-xl font-semibold text-gray-900">1 Nov</h3>
            <p class="text-gray-600">Shortlisting</p>
          </div>
        </div>
        
        <!-- 15 Nov - Interviews -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8 text-right">
            <h3 class="text-xl font-semibold text-gray-900">15 Nov</h3>
            <p class="text-gray-600">Interviews</p>
          </div>
          <div class="w-1/2 pl-8"></div>
        </div>
        
        <!-- 1 Dec - Offers -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8"></div>
          <div class="w-1/2 pl-8">
            <h3 class="text-xl font-semibold text-gray-900">1 Dec</h3>
            <p class="text-gray-600">Offers</p>
          </div>
        </div>
        
        <!-- 15 Dec - Visa & Travel -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8 text-right">
            <h3 class="text-xl font-semibold text-gray-900">15 Dec</h3>
            <p class="text-gray-600">Visa & Travel</p>
          </div>
          <div class="w-1/2 pl-8"></div>
        </div>
        
        <!-- 1 Jan - Program Start -->
        <div class="relative flex items-center">
          <div class="absolute left-1/2 transform -translate-x-1/2 w-4 h-4 bg-orange-500 rounded-full border-4 border-white shadow-lg"></div>
          <div class="w-1/2 pr-8"></div>
          <div class="w-1/2 pl-8">
            <h3 class="text-xl font-semibold text-gray-900">1 Jan</h3>
            <p class="text-gray-600">Program Start</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
