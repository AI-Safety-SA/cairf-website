---
// Key Details section component
import ApplyButton from './ApplyButton.astro';
---

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-text-base text-center mb-12">
      Key Details
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Location -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Location</h3>
        </div>
        <p class="text-text-muted">In-person in Cape Town, South Africa</p>
      </div>
      
      <!-- Application Deadline -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Application Deadline</h3>
        </div>
        <p class="text-text-muted">28 September 2025</p>
      </div>
      
      <!-- Start Date -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Start Date</h3>
        </div>
        <p class="text-text-muted">10 January 2026</p>
      </div>
      
      <!-- Duration -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Duration</h3>
        </div>
        <p class="text-text-muted">3 months, ending 13 April 2026</p>
      </div>
      
      <!-- Stipend -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Stipend</h3>
        </div>
        <p class="text-text-muted">$1170 (R21000)/month for living expenses and $669 (R12000)/month for accommodation for 3 months</p>
      </div>
      
      <!-- Travel Support -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Travel Support</h3>
        </div>
        <p class="text-text-muted">We cover flights to and from Cape Town</p>
      </div>
      
      <!-- Visas -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Visas</h3>
        </div>
        <p class="text-text-muted">We aren't able to cover visas, however visitors visas are easy to acquire for many countries and last up to 90 days</p>
      </div>
      
      <!-- Eligibility -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Eligibility</h3>
        </div>
        <p class="text-text-muted">Early career researchers interested in applying their skills to AI Safety with a background in machine learning, MARL, Game Theory, complex systems or Math are preferred</p>
      </div>
      
      <!-- Participants -->
      <div class="bg-surface-alt p-6 rounded-lg">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-primary/10 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-text-base">Participants</h3>
        </div>
        <p class="text-text-muted">6-12 fellows, with at least 30% from South African institutions</p>
      </div>
    </div>
    
    <!-- Apply button centered at bottom -->
    <div class="text-center mt-12">
      <ApplyButton />
    </div>
  </div>
</section>
