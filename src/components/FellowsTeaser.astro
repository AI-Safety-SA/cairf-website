---
import { loadFellows } from '../lib/fellows';

const fellows = loadFellows();
const teaser = fellows.slice(0, 5);
const overflow = fellows.length - teaser.length;
---

<section class="bg-surface-alt text-text-base border-y border-black/5">
  <div class="max-w-7xl mx-auto py-12 md:py-14 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-8 lg:items-center lg:justify-between">
      <div class="max-w-xl">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
          Fellows
        </span>
        <h2 class="text-2xl md:text-3xl font-semibold mb-3">Meet the Fellows</h2>
        <p class="text-base md:text-lg text-text-muted leading-relaxed">
          Browse all {fellows.length} fellow profiles — Bio, Research Interest, and Project Proposal merged into one card per person.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-5 sm:items-center">
        <div class="flex flex-col gap-2">
          <div class="flex -space-x-2.5">
            {teaser.map((fellow) => (
              fellow.primaryImage ? (
                <img
                  src={fellow.primaryImage}
                  alt={fellow.name}
                  class="w-11 h-11 rounded-full border-2 border-surface-alt object-cover shadow-sm"
                  loading="lazy"
                />
              ) : (
                <div class="w-11 h-11 rounded-full border-2 border-surface-alt bg-white text-xs font-bold text-primary flex items-center justify-center shadow-sm">
                  {fellow.name.split(' ').map((n: string) => n[0]).slice(0, 2).join('').toUpperCase()}
                </div>
              )
            ))}
            {overflow > 0 && (
              <div class="w-11 h-11 rounded-full border-2 border-surface-alt bg-white text-xs font-bold text-text-muted flex items-center justify-center shadow-sm">
                +{overflow}
              </div>
            )}
          </div>
          <p class="text-xs text-text-muted pl-0.5">{fellows.length} fellows in this cohort</p>
        </div>

        <a
          href="/fellows"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary text-white px-5 py-3 font-semibold hover:opacity-90 transition-opacity shrink-0"
        >
          View All Fellows
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
