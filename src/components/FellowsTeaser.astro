---
import { loadFellows } from '../lib/fellows';

const fellows = loadFellows();
const teaser = fellows.slice(0, 3);
---

<section class="bg-surface-alt text-text-base">
  <div class="max-w-7xl mx-auto py-14 md:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-8 lg:items-center lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-wider text-text-muted mb-3">New</p>
        <h2 class="text-2xl md:text-3xl font-semibold mb-4">Meet The Fellows</h2>
        <p class="text-base md:text-lg text-text-muted">
          Browse all {fellows.length} fellow cards with each person merged into a single profile across Bio, Research Interest, and Project Proposal.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-5 sm:items-center">
        <div class="flex -space-x-3">
          {teaser.map((fellow) => (
            fellow.primaryImage ? (
              <img
                src={fellow.primaryImage}
                alt={fellow.name}
                class="w-12 h-12 rounded-full border-2 border-white object-cover bg-white"
                loading="lazy"
              />
            ) : (
              <div class="w-12 h-12 rounded-full border-2 border-white bg-white text-xs font-semibold text-text-muted flex items-center justify-center">
                {fellow.name.slice(0, 2).toUpperCase()}
              </div>
            )
          ))}
        </div>
        <a
          href="/fellows"
          class="inline-flex items-center justify-center rounded-lg bg-primary text-white px-5 py-3 font-semibold hover:opacity-90 transition-opacity"
        >
          View All Fellows
        </a>
      </div>
    </div>
  </div>
</section>
