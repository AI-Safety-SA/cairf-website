---
import { loadFellows } from '../lib/fellows';
import { loadPosters } from '../lib/posters';

const fellows = loadFellows();
const posterFellowIds = new Set(loadPosters().flatMap((poster) => poster.fellows.map((fellow) => fellow.id)));
---

<section id="fellows" class="bg-surface text-text-base">
  <div class="max-w-5xl mx-auto pt-16 md:pt-20 pb-10 md:pb-14 px-4 sm:px-6 lg:px-8">
    <p class="text-xs uppercase tracking-wider text-primary font-semibold mb-3">Cohort 2025</p>
    <h1 class="text-2xl md:text-3xl font-semibold mb-4">Fellows</h1>
    <p class="text-base md:text-lg text-text-muted max-w-2xl leading-relaxed">
      Meet the fellows accepted to the Cooperative AI Research Fellowship and explore their bios, research interests, and project proposals.
    </p>
  </div>
</section>

<section class="bg-surface text-text-base">
  <div class="max-w-5xl mx-auto pb-16 md:pb-20 px-4 sm:px-6 lg:px-8">
    {fellows.length > 0 ? (
      <div>
        {fellows.map((fellow, index) => {
          const isImageRight = index % 2 === 0;
          const initials = fellow.name.split(' ').map((n: string) => n[0]).slice(0, 2).join('').toUpperCase();
          return (
            <article
              id={fellow.id}
              class:list={["fellow-entry py-12 md:py-16", { "border-t border-text-muted/25": index !== 0 }]}
            >

              <div class:list={["fellow-aside", isImageRight ? "photo-right" : "photo-left"]}>
                <div class="fellow-photo">
                  {fellow.primaryImage ? (
                    <img
                      src={fellow.primaryImage}
                      alt={`Portrait of ${fellow.name}`}
                      class="w-full h-full object-cover rounded-xl shadow-sm"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full rounded-xl bg-surface-alt flex items-center justify-center">
                      <span class="text-3xl font-bold text-primary">{initials}</span>
                    </div>
                  )}
                </div>
                {fellow.mentors && (
                  <div class="mt-3">
                    <h3 class="text-xs uppercase tracking-wider text-primary font-semibold mb-1">Mentors</h3>
                    <p class="text-text-muted text-sm leading-relaxed">{fellow.mentors}</p>
                  </div>
                )}
              </div>

              <h2 class="text-2xl md:text-3xl font-semibold mb-6 leading-tight">{fellow.name}</h2>

              {posterFellowIds.has(fellow.id) && (
                <p class="mb-6">
                  <a href={`/posters?poster=${fellow.id}`} class="poster-link">
                    View poster
                  </a>
                </p>
              )}

              <div class="space-y-5">
                {fellow.bio && (
                  <div>
                    <h3 class="text-xs uppercase tracking-wider text-primary font-semibold mb-2">Bio</h3>
                    <p class="text-text-muted leading-relaxed text-base">{fellow.bio}</p>
                  </div>
                )}
                {fellow.researchInterests && (
                  <div>
                    <h3 class="text-xs uppercase tracking-wider text-primary font-semibold mb-2">Research Interests</h3>
                    <p class="text-text-muted leading-relaxed text-base">{fellow.researchInterests}</p>
                  </div>
                )}
                {fellow.projectProposal && (
                  <div>
                    <h3 class="text-xs uppercase tracking-wider text-primary font-semibold mb-2">Project Proposal</h3>
                    <p class="text-text-muted leading-relaxed text-base">{fellow.projectProposal}</p>
                  </div>
                )}
              </div>

              <div class="clearfix"></div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="rounded-xl border border-surface-alt bg-surface-alt p-6">
        <p class="text-text-muted">No fellows data was found. Ensure the extracted slides JSON is available.</p>
      </div>
    )}
  </div>
</section>

<style>
  .fellow-aside {
    width: 260px;
    flex-shrink: 0;
  }

  .fellow-photo {
    width: 100%;
    aspect-ratio: 3 / 4;
  }

  .photo-right {
    float: right;
    margin-left: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .photo-left {
    float: left;
    margin-right: 2.5rem;
    margin-bottom: 1.5rem;
  }

  .clearfix::after {
    content: "";
    display: table;
    clear: both;
  }

  .fellow-entry {
    scroll-margin-top: 6.5rem;
  }

  .poster-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: hsl(15 85% 46% / 0.08);
    border: 1px solid hsl(15 85% 46% / 0.18);
    color: hsl(15 85% 40%);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease,
      transform 0.18s ease;
  }

  .poster-link::after {
    content: "↗";
    font-size: 0.95rem;
    line-height: 1;
  }

  .poster-link:hover,
  .poster-link:focus-visible {
    background: hsl(15 85% 46% / 0.14);
    border-color: hsl(15 85% 46% / 0.28);
    color: hsl(15 85% 34%);
    transform: translateY(-1px);
    outline: none;
  }

  @media (max-width: 640px) {
    .fellow-aside {
      float: none !important;
      width: 100%;
      margin: 0 0 1.5rem 0 !important;
    }

    .fellow-photo {
      aspect-ratio: 4 / 3;
    }
  }
</style>
