---
// Hero section component
import { Image } from 'astro:assets';
import dummyImage from '../assets/dummy_image.png';
---

<section class="relative min-h-screen flex items-center">
  <!-- Left side with background image -->
  <div class="w-1/2 relative">
    <Image 
      src={dummyImage} 
      alt="Abstract textured surface with diagonal line" 
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="relative z-10 flex items-center h-full">
      <div class="text-white px-8">
        <h2 class="text-4xl md:text-6xl font-serif leading-tight">
          Researching<br>
          cooperation for<br>
          multi-agent<br>
          systems
        </h2>
      </div>
    </div>
  </div>
  
  <!-- Right side with content -->
  <div class="w-1/2 bg-surface flex items-center justify-center px-12">
    <div class="max-w-lg">
      <p class="text-lg text-text-base mb-6 leading-relaxed">
        The Cooperative AI South Africa Fellowship is a fully funded 3 month research program for exceptional talent to work with globally recognised thought leaders in Cooperative AI to advance the safe and beneficial development of multi-agent AI systems.
      </p>
      
      <div class="mb-8">
        <p class="text-lg text-text-base">
          The application deadline is <strong>28 September 2025.</strong>
        </p>
      </div>
      
      <a href="#apply" class="inline-block bg-primary hover:bg-primary/90 text-white px-8 py-4 text-lg font-semibold transition-colors duration-200">
        APPLY NOW
      </a>
    </div>
  </div>
</section>
