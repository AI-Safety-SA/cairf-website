---
// Hero section component
import ApplyButton from './ApplyButton.astro';
import Image from 'astro/components/Image.astro';
import landingDesktop from '../assets/images/landing-desktop.jpg';
import landingMobile from '../assets/images/landing-mobile.jpg';
---

<section class="relative min-h-[calc(100vh-80px)]">
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={landingDesktop} 
      alt="Walking illustration background" 
      class="w-full h-full object-cover"
    />
  </div>
  
  <!-- Content overlay -->
  <div class="relative z-10 h-[calc(100vh-60px)] flex flex-col justify-between p-8 md:p-12 lg:px-32 lg:py-16">
    <!-- Top section - Main description in upper-left -->
    <div class="flex-1 flex items-start">
      <div class="max-w-5xl">
        <h1 class="text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-serif leading-tight text-white">
          A 3-month research fellowship developing<br>
          core topics in Cooperative AI, featuring<br>
          world-class mentorship.
        </h1>
      </div>
    </div>
    
    <!-- Bottom section - Application deadline and Apply button -->
    <div class="flex justify-between items-end">
      <!-- Application deadline in lower-left -->
      <div class="text-lg md:text-xl text-white">
        Apply by <strong>28 September 2025</strong>.
      </div>
      
      <!-- Apply button in lower-right -->
      <div class="hidden md:block">
        <ApplyButton variant="primary" />
      </div>
    </div>
  </div>
  
  <!-- Mobile Apply Button - centered at bottom -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 block md:hidden">
    <ApplyButton variant="primary" />
  </div>
</section>
