---
// Hero section component
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-image.png';
import ApplyButton from './ApplyButton.astro';
---

<section class="relative">
  <!-- Hero Section -->
  <div class="relative min-h-screen flex">
    <!-- Full-width heading overlay -->
    <div class="absolute inset-0 z-20 flex items-top justify-center px-6 mt-10 md:px-8 lg:px-12">
      <div class="text-center max-w-6xl">
        <h1 class="text-2xl md:text-4xl lg:text-5xl xl:text-6xl font-serif leading-tight text-white drop-shadow-lg">
          A 3-month research fellowship focussed on cooperation in multi-agent systems with mentors from AI safety.
        </h1>
      </div>
    </div>
    
    <!-- Left side - Content with green background (Desktop) -->
    <div class="hidden md:flex md:w-2/5 bg-green-dark items-end justify-center relative z-10">
      <div class="text-white px-8 md:px-12 lg:px-16 max-w-lg">
        <div class="space-y-6 mb-30">
          <p class="text-md md:text-lg lg:text-xl leading-relaxed">
            The Cooperative AI guild is hosting a fully funded 3 month research fellowship for exceptional talent to work with globally recognised thought leaders in Cooperative AI to advance the safe and beneficial development of multi-agent AI systems.
          </p>
          
          <div>
            <p class="text-lg md:text-xl">
              The application deadline is <strong>28 September 2025</strong>.
            </p>
          </div>
          
          <ApplyButton variant="desktop" />
        </div>
      </div>
    </div>
    
    <!-- Right side - Hero image (Desktop) -->
    <div class="hidden md:block md:w-3/5 relative">
      <Image 
        src={heroImage} 
        alt="Two figures exploring a fantastical underwater forest with glowing fish-like creatures" 
        class="absolute inset-0 w-full h-full object-cover"
      />
    </div>
    
    <!-- Mobile layout - Full background image with text overlay -->
    <div class="md:hidden relative w-full min-h-screen">
      <Image 
        src={heroImage} 
        alt="Two figures exploring a fantastical underwater forest with glowing fish-like creatures" 
        class="absolute inset-0 w-full h-full object-cover"
      />
      
      <!-- Text Overlay for Mobile -->
      <div class="relative z-10 flex items-end h-full">
        <div class="w-full">
          <div class="bg-green-dark p-6">
            <h1 class="text-2xl font-serif text-white leading-tight mb-6">
              A 3-month research fellowship focussed on cooperation in multi-agent systems with mentors from AI safety.
            </h1>
            
            <div class="space-y-4">
              <p class="text-base leading-relaxed text-white">
                The Cooperative AI guild is hosting a fully funded 3 month research fellowship for exceptional talent to work with globally recognised thought leaders in Cooperative AI to advance the safe and beneficial development of multi-agent AI systems.
              </p>
              
              <div>
                <p class="text-base text-white">
                  The application deadline is <strong>28 September 2025</strong>.
                </p>
              </div>
              
              <ApplyButton variant="mobile" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
