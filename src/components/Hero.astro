---
// Hero section component
import Image from 'astro/components/Image.astro';
import landingDesktop from '../assets/images/landing-desktop.jpg';
import landingMobile from '../assets/images/landing-mobile.jpg';
---

<section id="hero" class="relative min-h-[calc(100vh-80px)] md:min-h-[calc(100vh-80px)]">
  <!-- Desktop Background image -->
  <div class="absolute inset-0 z-0 hidden md:block">
    <Image 
      src={landingDesktop} 
      alt="Research outdoors with an AI Robot" 
      class="w-full h-full object-cover"
      priority={true}
      layout='full-width'
    />
  </div>
  
  <!-- Mobile Background image -->
  <div class="absolute inset-0 z-0 block md:hidden">
    <Image 
      src={landingMobile} 
      alt="Research outdoors with an AI Robot" 
      class="w-full h-full object-cover"
      priority={true}
      layout='full-width'
    />
  </div>
  
  <!-- Desktop Content overlay -->
  <div class="relative z-10 h-[calc(100vh-80px)] hidden md:flex flex-col justify-between p-8 md:p-12 lg:px-32 lg:py-16">
    <!-- Top section - Main description in upper-left -->
    <div class="flex-1 flex items-start">
      <div class="max-w-5xl">
        <h1 class="text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-serif leading-tight text-white">
          A 3-month research fellowship developing<br>
          core topics in cooperative AI, with<br>
          world-class mentorship.
        </h1>
      </div>
    </div>
    
    <!-- Bottom section - Fellowship status and posters CTA -->
    <div class="flex justify-between items-end">
      <!-- Fellowship status in lower-left -->
      <div class="max-w-xl text-lg md:text-xl text-white">
        The 2026 fellowship has <strong>concluded</strong>. Explore the cohort's research outcomes.
      </div>
      
      <!-- Posters CTA in lower-right -->
      <div>
        <a
          href="/posters"
          class="inline-block rounded-sm border-1 border-primary bg-primary/90 px-8 py-2.5 font-sans text-xl font-extrabold text-white transition-all duration-200 hover:bg-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
        >
          VIEW POSTERS
        </a>
      </div>
    </div>
  </div>
  
  <!-- Mobile Content overlay -->
  <div class="relative z-10 min-h-[calc(100vh-80px)] flex md:hidden flex-col max-h-screen">
    <!-- Dark teal overlay with text content -->
    <div class="flex flex-col justify-start px-4 sm:px-6 pt-8 pb-8 flex-1 overflow-hidden">
      <div class="max-w-l">
        <h1 class="text-2xl sm:text-3xl font-serif leading-tight text-white mb-4">
          A 3-month research fellowship developing core topics in cooperative AI, with world-class mentorship.
        </h1>
        
        <p class="text-sm sm:text-base text-white">
          The 2026 fellowship has <strong>concluded</strong>. Explore the cohort's research outcomes.
        </p>
      </div>
    </div>
    
    <!-- Bottom section for CTA - ensure it's always visible -->
    <div class="flex justify-center mb-12 lg:mb-0 px-4 sm:px-6 pb-6 pt-4 flex-shrink-0 mobile-safe-area">
      <a
        href="/posters"
        class="inline-block rounded-sm border-1 border-primary bg-primary/90 px-8 py-2.5 font-sans text-xl font-extrabold text-white transition-all duration-200 hover:bg-primary focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
      >
        VIEW POSTERS
      </a>
    </div>
  </div>
</section>
