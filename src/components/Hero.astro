---
// Hero section component
import { Image } from 'astro:assets';
import dummyImage from '../assets/dummy_image.png';
---

<section class="relative min-h-screen flex items-center">
  <!-- Left side with background image -->
  <div class="w-1/2 relative">
    <Image 
      src={dummyImage} 
      alt="Abstract textured surface with diagonal line" 
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="relative z-10 flex items-center justify-center h-full">
      <div class="text-center text-white px-8">
        <h2 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
          Researching cooperation for multi-agent systems
        </h2>
      </div>
    </div>
  </div>
  
  <!-- Right side with content -->
  <div class="w-1/2 bg-yellow-50 flex items-center justify-center px-12">
    <div class="max-w-lg">
      <p class="text-lg text-gray-700 mb-6 leading-relaxed">
        The Cooperative AI South Africa Fellowship is a 6-month research project for talented South African researchers to explore how to ensure that future AI systems are cooperative and beneficial to humanity.
      </p>
      
      <div class="mb-8">
        <p class="text-sm text-gray-600 mb-2">Applications close</p>
        <p class="text-2xl font-bold text-gray-900">15th November 2023</p>
      </div>
      
      <a href="#apply" class="inline-block bg-orange-500 hover:bg-orange-600 text-white px-8 py-4 rounded-md text-lg font-semibold transition-colors duration-200">
        APPLY NOW
      </a>
    </div>
  </div>
</section>
