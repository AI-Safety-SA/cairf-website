---
// Header component with navigation
---

<header class="bg-surface shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center py-4">
      <!-- Logo/Site Title -->
      <div class="flex-shrink-0">
        <h1 class="text-xl font-semibold text-text-base">
          Cooperative AI South Africa Fellowship
        </h1>
      </div>
      
      <!-- Navigation -->
      <nav class="hidden md:flex space-x-8">
        <a href="#about" class="text-text-muted hover:text-text-base px-3 py-2 text-sm font-medium">About</a>
        <a href="#tracks" class="text-text-muted hover:text-text-base px-3 py-2 text-sm font-medium">Tracks</a>
        <a href="#partners" class="text-text-muted hover:text-text-base px-3 py-2 text-sm font-medium">Partners</a>
        <a href="#faq" class="text-text-muted hover:text-text-base px-3 py-2 text-sm font-medium">FAQ</a>
      </nav>
      
      <!-- Apply Button -->
      <div class="flex-shrink-0">
        <a href="#apply" class="bg-primary hover:bg-primary/90 text-white px-6 py-2 rounded-md text-sm font-medium transition-colors duration-200">
          APPLY
        </a>
      </div>
    </div>
  </div>
</header>
