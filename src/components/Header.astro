---
// Import new logo variants
import logo from '../assets/logos/cairf_logo.png'

// Import icons for mobile navigation
import hamburgerIcon from '../assets/icons/hamburger.svg?raw'
import crossIcon from '../assets/icons/cross.svg?raw'

// Import ApplyButton component
import ApplyButton from './ApplyButton.astro'

import Image from 'astro/components/Image.astro';

const isHomePage = Astro.url.pathname === '/';
const homePrefix = isHomePage ? '' : '/';
const heroHref = isHomePage ? '#hero' : '/#hero';
---

<header class="bg-white shadow-sm border-b border-gray-100 sticky top-0 z-50 py-1 md:py-2">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo/Title -->
      <div class="flex-shrink-0">
        <!-- Full logo with text -->
        <div>
          <a href={heroHref}>
            <Image src={logo} alt="Cooperative AI Research Fellowship Logo" layout='constrained' class="h-10 md:h-12 w-auto" />
          </a>
        </div>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex space-x-8 font-sans">
        <a href={`${homePrefix}#about`} class="text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          About
        </a>
        <a href={`${homePrefix}#tracks`} class="text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Tracks
        </a>
        <a href={`${homePrefix}#mentorship`} class="text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Mentors
        </a>
        <a href="/fellows" class="text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Fellows
        </a>
        <a href={`${homePrefix}#partners`} class="text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Partners
        </a>
        <a href={`${homePrefix}#faq`} class="text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          FAQ
        </a>
      </nav>

      <!-- Desktop Apply Button -->
      <div class="hidden md:block">
        <ApplyButton variant="secondary" />
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button
          id="mobile-menu-button"
          class="text-text-base hover:text-gray-600 focus:outline-none focus:text-gray-600 p-2 rounded-md hover:bg-gray-100 transition-colors duration-200"
          aria-label="Toggle mobile menu"
          type="button"
        >
          <div id="hamburger-icon" class="h-6 w-6" set:html={hamburgerIcon}></div>
          <div id="cross-icon" class="h-6 w-6 hidden" set:html={crossIcon}></div>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-menu" class="hidden md:hidden">
      <div class="px-2 pt-2 pb-3 space-y-1 bg-white font-sans">
        <a href={`${homePrefix}#about`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          About
        </a>
        <a href={`${homePrefix}#key-details`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Key Details
        </a>
        <a href={`${homePrefix}#tracks`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Research Tracks
        </a>
        <a href={`${homePrefix}#mentorship`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Mentorship
        </a>
        <a href="/fellows" class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Fellows
        </a>
        <a href={`${homePrefix}#application-process`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Application Process
        </a>
        <a href={`${homePrefix}#selection-criteria`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Selection Criteria
        </a>
        <a href={`${homePrefix}#why-cooperative-ai`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Why Cooperative AI
        </a>
        <a href={`${homePrefix}#why-south-africa`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Why South Africa
        </a>
        <a href={`${homePrefix}#timeline`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Timeline
        </a>
        <a href={`${homePrefix}#partners`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Partners
        </a>
        <a href={`${homePrefix}#faq`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          FAQ
        </a>
        <a href={`${homePrefix}#webinar`} class="block px-3 py-2 text-text-base hover:text-gray-600 transition-colors duration-200 font-medium">
          Webinar Recording
        </a>
        <div class="p-6 flex justify-center">
          <ApplyButton variant="secondary" />
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle with proper icon switching
  document.addEventListener('DOMContentLoaded', function() {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const crossIcon = document.getElementById('cross-icon');
    
    if (button && menu && hamburgerIcon && crossIcon) {
      button.onclick = function() {
        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          hamburgerIcon.classList.add('hidden');
          crossIcon.classList.remove('hidden');
        } else {
          menu.classList.add('hidden');
          hamburgerIcon.classList.remove('hidden');
          crossIcon.classList.add('hidden');
        }
      };
      
      // Close menu when clicking on links
      const links = menu.querySelectorAll('a');
      links.forEach(link => {
        link.onclick = function(e) {
          const anchorElement = (e.target as HTMLElement).closest('a') as HTMLAnchorElement;
          if (!anchorElement) return;
          
          const href = anchorElement.getAttribute('href');
          
          // External links (including route links) use default browser navigation.
          if (href && (href.startsWith('http') || href.startsWith('https') || href.startsWith('mailto:'))) {
            menu.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            crossIcon.classList.add('hidden');
            return;
          }

          if (href && href.startsWith('/')) {
            menu.classList.add('hidden');
            hamburgerIcon.classList.remove('hidden');
            crossIcon.classList.add('hidden');
            return;
          }
          
          // Same-page anchors use smooth scrolling.
          e.preventDefault();
          // Close menu immediately
          menu.classList.add('hidden');
          hamburgerIcon.classList.remove('hidden');
          crossIcon.classList.add('hidden');
          
          // Small delay to ensure menu is closed before scroll
          setTimeout(() => {
            if (href) {
              const targetElement = document.querySelector(href);
              if (targetElement) {
                // Get header height for offset
                const header = document.querySelector('header');
                const headerHeight = header ? header.offsetHeight : 64;
                
                // Calculate target position with header offset
                const targetPosition = (targetElement as HTMLElement).offsetTop - headerHeight;
                
                window.scrollTo({
                  top: targetPosition,
                  behavior: 'smooth'
                });
              }
            }
          }, 100);
        };
      });
    }
  });
</script>
