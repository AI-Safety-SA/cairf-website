---
export interface Props {
  href: string;
  display_name: string;
}

const { href, display_name } = Astro.props;
---

<li>
  <a
    href={href}
    class="block m-2 py-2 px-3 text-white font-medium transition-colors duration-300
      bg-green-dark rounded-2xl
      hover:underline hover:text-white
      md:bg-transparent md:rounded md:m-0
      md:hover:bg-transparent md:hover:underline md:hover:text-white"
  >
    {display_name}
  </a>
</li>

 