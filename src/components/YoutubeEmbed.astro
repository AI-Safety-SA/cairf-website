---
// Youtube Video section component
---

<section id="yt-embed" class="bg-surface text-text-base">
  <div class="max-w-7xl mx-auto py-20 px-8 sm:px-16 lg:px-20">
    <h2 class="text-2xl md:text-3xl font-semibold mb-12">
      Information Session Webinar Recording
    </h2>
    
    <div class="flex flex-col items-center">
        <div class="relative w-full" style="padding-bottom: 56.25%;">
          <iframe 
            class="absolute top-0 left-0 w-full h-full rounded-lg shadow-lg"
            src="https://www.youtube.com/embed/b5V-VAIR9EE"
            title="CAIRF Information Session Webinar"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="lazy">
          </iframe>
      </div>
    </div>
  </div>
</section>
