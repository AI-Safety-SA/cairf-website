---
// Selection Criteria section component
import { Image } from 'astro:assets';
import dummyImage from '../assets/dummy_image.png';
---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left side with placeholder panel -->
      <div class="bg-gray-100 h-96 rounded-lg overflow-hidden">
        <Image 
          src={dummyImage} 
          alt="Abstract textured surface" 
          class="w-full h-full object-cover"
        />
      </div>
      
      <!-- Right side with content -->
      <div class="bg-yellow-50 p-8 rounded-lg">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-8">
          Selection Criteria
        </h2>
        
        <div class="mb-8">
          <p class="text-lg text-gray-700 leading-relaxed">
            Our key criterion is the potential to conduct impactful cooperative AI research. As evidence of this, we evaluate applications on the strength of your research proposal as well as your experience, skills and career aspirations.
          </p>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-sm mb-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Research proposals should:</h3>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="text-orange-500 mr-3">•</span>
              <span>Be focused on multi-agent cooperation problems involving AI systems</span>
            </li>
            <li class="flex items-start">
              <span class="text-orange-500 mr-3">•</span>
              <span>Produce results that are relevant to advanced and future AI systems</span>
            </li>
            <li class="flex items-start">
              <span class="text-orange-500 mr-3">•</span>
              <span>Aim to contribute to societally beneficial AI development</span>
            </li>
          </ul>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-sm">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Your proposal will be evaluated in terms of:</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="flex items-start">
              <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Impact</h4>
                <p class="text-gray-600 text-sm">Potential contribution to the field</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Tractability</h4>
                <p class="text-gray-600 text-sm">Feasibility of completion</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Neglectedness</h4>
                <p class="text-gray-600 text-sm">Addressing under-researched areas</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 mb-1">Risk</h4>
                <p class="text-gray-600 text-sm">Assessment of potential risks</p>
              </div>
            </div>
          </div>
          
          <div class="mt-6 p-4 bg-yellow-50 rounded-lg">
            <p class="text-gray-700 text-sm">
              Further instructions can be found on the application form.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
