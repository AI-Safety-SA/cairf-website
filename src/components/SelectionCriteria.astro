---
// Selection Criteria section component
---

<section class="py-20 bg-yellow-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12">
      Selection Criteria
    </h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Strong academic record -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">Strong academic record</h3>
        </div>
        <p class="text-gray-700">Demonstrated excellence in relevant academic fields including computer science, mathematics, or related disciplines.</p>
      </div>
      
      <!-- Research experience -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">Research experience</h3>
        </div>
        <p class="text-gray-700">Prior research experience in AI, machine learning, or related fields with demonstrated ability to conduct independent research.</p>
      </div>
      
      <!-- Interest in cooperative AI -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">Interest in cooperative AI</h3>
        </div>
        <p class="text-gray-700">Genuine interest and motivation to work on cooperative AI research and contribute to the field's advancement.</p>
      </div>
      
      <!-- Communication skills -->
      <div class="bg-white p-6 rounded-lg shadow-sm">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">Communication skills</h3>
        </div>
        <p class="text-gray-700">Strong written and verbal communication skills with ability to present research findings and collaborate effectively.</p>
      </div>
      
      <!-- Commitment to the program -->
      <div class="bg-white p-6 rounded-lg shadow-sm md:col-span-2">
        <div class="flex items-center mb-4">
          <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center mr-4">
            <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900">Commitment to the program</h3>
        </div>
        <p class="text-gray-700">Full commitment to the 6-month program with dedication to research excellence and active participation in all fellowship activities.</p>
      </div>
    </div>
  </div>
</section>
