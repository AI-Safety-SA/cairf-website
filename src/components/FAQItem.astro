---
export interface Props {
  question: string;
  answer: string | string[];
  isLast?: boolean;
}

const { question, answer, isLast = false } = Astro.props;
---

<div class="faq-item">
  <!-- Desktop version: Dropdown (non-accordion) -->
  <div class="hidden md:block">
    <button 
      class="faq-toggle-desktop w-full px-2 py-4 rounded-lg text-left flex items-center justify-between hover:bg-white/5 transition-colors duration-200"
      data-faq-toggle-desktop
    >
      <h3 class="text-lg font-semibold text-white pr-4">{question}</h3>
      <svg 
        class="faq-arrow-desktop w-5 h-5 text-white transform transition-transform duration-200 flex-shrink-0" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
    
    <div class="faq-content-desktop hidden pb-4">
      <div class="text-white/80 mb-6">
        {Array.isArray(answer) ? (
          <ul class="space-y-2">
            {answer.map((item) => <li>{item}</li>)}
          </ul>
        ) : (
          <p>{answer}</p>
        )}
      </div>
    </div>
    
    {!isLast && <hr class="border-white/20 mb-6" />}
  </div>

  <!-- Mobile version: Accordion dropdown -->
  <div class="md:hidden">
    <button 
      class="faq-toggle w-full py-4 text-left flex items-center justify-between hover:bg-white/5 transition-colors duration-200"
      data-faq-toggle
    >
      <h3 class="text-lg font-semibold text-white pr-4">{question}</h3>
      <svg 
        class="faq-arrow w-5 h-5 text-white transform transition-transform duration-200 flex-shrink-0" 
        fill="none" 
        stroke="currentColor" 
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
    
    <div class="faq-content hidden pb-4">
      <div class="text-white/80">
        {Array.isArray(answer) ? (
          <ul class="space-y-2">
            {answer.map((item) => <li>{item}</li>)}
          </ul>
        ) : (
          <p>{answer}</p>
        )}
      </div>
    </div>
    
    {!isLast && <hr class="border-white/20" />}
  </div>
</div>

<script>
  // FAQ dropdown functionality
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile accordion functionality (existing)
    const faqToggles = document.querySelectorAll('[data-faq-toggle]');
    
    faqToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const faqItem = toggle.closest('.faq-item');
        const content = faqItem?.querySelector('.faq-content');
        const arrow = faqItem?.querySelector('.faq-arrow');
        
        if (content && arrow) {
          const isOpen = !content.classList.contains('hidden');
          
          // Close all other FAQ items (accordion behavior)
          document.querySelectorAll('.faq-content').forEach(item => {
            item.classList.add('hidden');
          });
          document.querySelectorAll('.faq-arrow').forEach(item => {
            item.classList.remove('rotate-180');
          });
          
          // Toggle current item
          if (!isOpen) {
            content.classList.remove('hidden');
            arrow.classList.add('rotate-180');
          }
        }
      });
    });

    // Desktop dropdown functionality (non-accordion)
    const faqTogglesDesktop = document.querySelectorAll('[data-faq-toggle-desktop]');
    
    faqTogglesDesktop.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const faqItem = toggle.closest('.faq-item');
        const content = faqItem?.querySelector('.faq-content-desktop');
        const arrow = faqItem?.querySelector('.faq-arrow-desktop');
        
        if (content && arrow) {
          const isOpen = !content.classList.contains('hidden');
          
          // Toggle current item only (no accordion behavior)
          if (isOpen) {
            content.classList.add('hidden');
            arrow.classList.remove('rotate-180');
          } else {
            content.classList.remove('hidden');
            arrow.classList.add('rotate-180');
          }
        }
      });
    });
  });
</script>
