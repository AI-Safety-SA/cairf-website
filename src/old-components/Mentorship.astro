---
// Mentorship section component
import { Image } from 'astro:assets';
import dummyImage from '../assets/dummy_image.png';
---

<section class="py-20 bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left side with placeholder panel -->
      <div class="bg-surface-alt h-96 rounded-lg overflow-hidden">
        <Image 
          src={dummyImage} 
          alt="Abstract textured surface" 
          class="w-full h-full object-cover"
        />
      </div>
      
      <!-- Right side with content -->
      <div class="bg-yellow p-8 rounded-lg">
        <h2 class="text-3xl md:text-4xl font-bold text-text-base mb-8">
          Mentorship
        </h2>
        
        <p class="text-lg text-text-muted leading-relaxed mb-8">
          Fellows will receive mentorship from leading researchers in cooperative AI, providing guidance, feedback, and support throughout the fellowship.
        </p>
        
        <div class="flex flex-col space-y-6">
          <div class="flex items-start">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mr-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-text-base mb-2">Expert Mentors</h3>
              <p class="text-text-muted">Top researchers in cooperative AI</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mr-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-text-base mb-2">Research Managers</h3>
              <p class="text-text-muted">Weekly guidance and resource connection</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
