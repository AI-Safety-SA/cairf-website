---
import '../styles/global.css';

import Header from '../components/Header.astro';
import FellowsSection from '../components/FellowsSection.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>Fellows | Cooperative AI Research Fellowship</title>
    <meta
      name="description"
      content="Meet the fellows and explore their bios and research interests from the CAIRF Names & Faces deck."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface font-sans">
    <Header />
    <main>
      <FellowsSection />
    </main>
    <Footer />
  </body>
</html>
