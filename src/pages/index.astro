---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ResearchTracks from '../components/ResearchTracks.astro';
import ApplicationDetails from '../components/ApplicationDetails.astro';
import Mentorship from '../components/Mentorship.astro';
import Timeline from '../components/Timeline.astro';
import Partnerships from '../components/Partnerships.astro';
import FAQ from '../components/FAQ.astro';
import WhySections from '../components/WhySections.astro';
import KeyDetails from '../components/KeyDetails.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import FellowsTeaser from '../components/FellowsTeaser.astro';
---

<SiteLayout
	title="Cooperative AI Research Fellowship"
	description="Join the Cooperative AI South Africa Fellowship and contribute to cutting-edge research in multi-agent cooperation. Applications close 1 October 2025."
>
	<!-- Hero Section -->
	<Hero />
	<FellowsTeaser />
	
	<!-- About Section -->
	<About />

	<KeyDetails />

	<!-- Research Tracks Section -->
	<ResearchTracks />
	<div class="hidden md:block max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
		<hr class="text-text-base">
	</div>
	<!-- Mentorship Section -->
	<Mentorship />

	<!-- Application Details Section -->
	<ApplicationDetails />
			
	<!-- Why Cooperative AI and Why South Africa Section -->
	<WhySections />
	
	<!-- Timeline Section -->
	<Timeline />

	<!-- Partnerships Section -->
	<Partnerships />
	
	<!-- FAQ Section -->
	<FAQ />

	<!-- Youtube Embed -->
	<YoutubeEmbed />
</SiteLayout>
