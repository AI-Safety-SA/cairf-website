---
import '../styles/global.css'
// Import all components
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import KeyDetails from '../components/KeyDetails.astro';
import ResearchTracks from '../components/ResearchTracks.astro';
import ContentSections from '../components/ContentSections.astro';
import ApplicationDetails from '../components/ApplicationDetails.astro';
import Timeline from '../components/Timeline.astro';
import Partnerships from '../components/Partnerships.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Cooperative AI South Africa Fellowship</title>
		<meta name="description" content="Join the Cooperative AI South Africa Fellowship and contribute to cutting-edge research in multi-agent cooperation. Applications close 28 September 2025." />
	</head>
	<body class="bg-white">
		<!-- Header -->
		<Header />
		
		<!-- Hero Section -->
		<Hero />
		
		<!-- About Section -->
		<About />
		
		<!-- Key Details Section -->
		<KeyDetails />
		
		<!-- Research Tracks Section -->
		<ResearchTracks />
		
		<!-- Application Details Section -->
		<ApplicationDetails />
		
		<!-- Content Sections (Why Cooperative AI and Why South Africa) -->
		<ContentSections />
		
		<!-- Timeline Section -->
		<Timeline />
		
		<!-- Partnerships Section -->
		<Partnerships />
		
		<!-- FAQ Section -->
		<FAQ />
		
		<!-- Footer -->
		<Footer />
		
		<!-- Smooth scrolling for anchor links -->
		<script>
			document.querySelectorAll('a[href^="#"]').forEach(anchor => {
				anchor.addEventListener('click', (e: Event) => {
					e.preventDefault();
					const href = (e.target as HTMLAnchorElement).getAttribute('href');
					if (href) {
						const target = document.querySelector(href);
						if (target) {
							target.scrollIntoView({
								behavior: 'smooth',
								block: 'start'
							});
						}
					}
				});
			});
		</script>
	</body>
</html>
