---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PosterCard from '../components/PosterCard.astro';
import { loadPosters } from '../lib/posters';

const posters = loadPosters();

const allThumbs = import.meta.glob<{ default: ImageMetadata }>('../assets/Posters/*.png');

const postersWithImages = await Promise.all(
  posters.map(async (poster) => {
    const key = `../assets/Posters/${poster.thumbFile}`;
    const mod = allThumbs[key];
    const thumbImage = mod ? (await mod()).default : null;
    return { ...poster, thumbImage };
  })
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>Research Posters | Cooperative AI Research Fellowship</title>
    <meta name="description" content="Research posters from the 2025 CAIRF cohort, showcasing work on cooperative AI, multi-agent systems, and AI safety." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="font-sans" style="background: hsl(120 85% 5%);">
    <Header />

    <main>
      <!-- Hero -->
      <section class="hero">
        <div class="hero-inner">
          <p class="overline">2025 Fellowship Cohort</p>
          <h1 class="page-title">Research Posters</h1>
          <p class="page-sub">
            Explore the research projects of our fellows — from cooperative multi-agent systems<br class="hidden md:inline" />
            to AI safety, alignment, and human-AI collaboration.
          </p>
        </div>

        <!-- Decorative ruled lines -->
        <div class="hero-rules" aria-hidden="true">
          <div class="rule"></div>
          <div class="rule rule--accent"></div>
          <div class="rule"></div>
        </div>
      </section>

      <!-- Masonry grid -->
      <section class="grid-section">
        <div class="masonry">
          {postersWithImages.map(({ thumbImage, ...poster }) => (
            <PosterCard poster={poster} thumbImage={thumbImage} />
          ))}
        </div>
      </section>
    </main>

    <dialog id="poster-lightbox" class="poster-lightbox" aria-label="Poster preview">
      <button type="button" class="poster-lightbox-close" data-lightbox-close aria-label="Close poster preview">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18M6 6l12 12" />
        </svg>
      </button>
      <div class="poster-lightbox-frame">
        <img id="poster-lightbox-image" class="poster-lightbox-image" alt="" />
      </div>
    </dialog>

    <Footer />
  </body>
</html>

<style>
  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: 5rem 2rem 3.5rem;
    text-align: center;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 740px;
    margin: 0 auto;
  }

  .overline {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: hsl(15 85% 58%);
    margin: 0 0 1.25rem;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 700;
    color: #fff;
    line-height: 1.05;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }

  .page-sub {
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 2vw, 1.0625rem);
    line-height: 1.65;
    color: rgba(255,255,255,0.45);
    margin: 0;
  }

  /* Decorative horizontal rules */
  .hero-rules {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: 3.5rem;
    opacity: 0.18;
  }

  .rule {
    height: 1px;
    background: rgba(255,255,255,0.6);
  }

  .rule--accent {
    height: 2px;
    background: hsl(15 85% 56%);
    opacity: 1;
  }

  /* ── Masonry grid ──────────────────────────────────────── */
  .grid-section {
    padding: 3rem 1.5rem 6rem;
  }

  .masonry {
    max-width: 1440px;
    margin: 0 auto;
    columns: 3 380px;
    column-gap: 1.75rem;
  }

  @media (max-width: 600px) {
    .grid-section { padding: 2rem 1rem 4rem; }
    .masonry { columns: 1; }
  }
</style>

<style is:global>
  body.poster-lightbox-open {
    overflow: hidden;
  }

  .poster-lightbox {
    width: min(96vw, 1240px);
    max-width: none;
    margin: auto;
    padding: 1.25rem;
    border: 0;
    border-radius: 24px;
    background: rgba(14, 14, 14, 0.92);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
  }

  .poster-lightbox::backdrop {
    background: rgba(7, 7, 7, 0.8);
    backdrop-filter: blur(6px);
  }

  .poster-lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .poster-lightbox-close:hover,
  .poster-lightbox-close:focus-visible {
    background: rgba(255, 255, 255, 0.2);
    outline: none;
  }

  .poster-lightbox-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: calc(100vh - 4rem);
    overflow: auto;
  }

  .poster-lightbox-image {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: calc(100vh - 6rem);
    border-radius: 14px;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.45);
  }

  @media (max-width: 720px) {
    .poster-lightbox {
      width: calc(100vw - 1rem);
      padding: 0.75rem;
      border-radius: 18px;
    }

    .poster-lightbox-close {
      top: 0.75rem;
      right: 0.75rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('poster-lightbox');
    const image = document.getElementById('poster-lightbox-image');

    if (!(dialog instanceof HTMLDialogElement) || !(image instanceof HTMLImageElement)) return;

    const closeLightbox = () => {
      if (!dialog.open) return;
      dialog.close();
    };

    const openLightbox = (src: string, alt: string) => {
      document.body.classList.add('poster-lightbox-open');
      image.src = src;
      image.alt = alt;
      dialog.showModal();
    };

    document.querySelectorAll<HTMLElement>('.poster-lightbox-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const src = trigger.dataset.posterSrc;
        const alt = trigger.dataset.posterAlt ?? 'Poster preview';
        if (!src) return;
        openLightbox(src, alt);
      });
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeLightbox();
    });

    dialog.querySelectorAll<HTMLElement>('[data-lightbox-close]').forEach((element) => {
      element.addEventListener('click', closeLightbox);
    });

    dialog.addEventListener('close', () => {
      document.body.classList.remove('poster-lightbox-open');
      image.removeAttribute('src');
      image.alt = '';
    });

    dialog.addEventListener('cancel', () => {
      document.body.classList.remove('poster-lightbox-open');
    });
  });
</script>
