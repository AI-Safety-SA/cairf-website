---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadFellows } from '../lib/fellows';

const fellows = loadFellows();
const fellowsById = Object.fromEntries(fellows.map(f => [f.id, f]));

type PosterEntry = {
  pdf: string;
  fellowIds: string[];
  // width/height e.g. "2160/1804" — used for CSS aspect-ratio
  aspectRatio: string;
};

const posters: PosterEntry[] = [
  { pdf: '/posters/akash.pdf',        fellowIds: ['akash-kundu'],                       aspectRatio: '2160/1804' },
  { pdf: '/posters/bhavyesh.pdf',     fellowIds: ['bhavyesh-sajja'],                    aspectRatio: '960/540'   },
  { pdf: '/posters/van.pdf',          fellowIds: ['van-quynh-thi-truong'],              aspectRatio: '2592/1728' },
  { pdf: '/posters/mariana.pdf',      fellowIds: ['mariana-meireles'],                  aspectRatio: '864/1296'  },
  { pdf: '/posters/omer.pdf',         fellowIds: ['omer-kamal-ebead'],                  aspectRatio: '2384/3370' },
  { pdf: '/posters/pramod.pdf',       fellowIds: ['pramod-kaushik'],                    aspectRatio: '2384/3370' },
  { pdf: '/posters/qi.pdf',           fellowIds: ['qi-guo'],                            aspectRatio: '2384/3370' },
  { pdf: '/posters/yves.pdf',         fellowIds: ['yves-bicker'],                       aspectRatio: '2380/3368' },
  { pdf: '/posters/joseph-oscar.pdf', fellowIds: ['joseph-low', 'oscar-duys'],          aspectRatio: '595/842'   },
];

function truncate(text: string, max = 220): string {
  if (text.length <= max) return text;
  const cut = text.lastIndexOf(' ', max);
  return text.slice(0, cut > 0 ? cut : max) + '…';
}

function uniqueMentors(ids: string[]): string {
  const all = ids.flatMap(id => {
    const m = fellowsById[id]?.mentors;
    return m ? m.split(/\s*[&,]\s*/).map(s => s.trim()) : [];
  });
  return [...new Set(all)].join(' & ');
}

function isLandscape(aspectRatio: string): boolean {
  const [w, h] = aspectRatio.split('/').map(Number);
  return w > h;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <meta name="generator" content={Astro.generator} />
    <title>Research Posters | Cooperative AI Research Fellowship</title>
    <meta
      name="description"
      content="Browse research posters from CAIRF fellows showcasing their work in cooperative AI safety."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Lora:ital,wght@0,400..700;1,400..700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface font-sans">
    <Header />
    <main>
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 py-16 sm:py-20">
        <div class="mb-10">
          <h1 class="font-serif text-4xl sm:text-5xl text-text-base mb-3">Research Posters</h1>
          <p class="text-text-muted text-lg max-w-2xl">
            Fellows share their work from the 2025 Cooperative AI Research Fellowship.
          </p>
        </div>

        <!-- 3-column grid; landscape posters span 2 cols, portraits span 1 -->
        <!-- grid-flow-dense lets portrait cards backfill gaps beside landscape ones -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-start grid-flow-dense">
          {posters.map((poster) => {
            const posterFellows = poster.fellowIds.map(id => fellowsById[id]).filter(Boolean);
            const names = posterFellows.map(f => f!.name);
            const mentors = uniqueMentors(poster.fellowIds);
            const landscape = isLandscape(poster.aspectRatio);

            return (
              <article class={`${landscape ? 'md:col-span-2 lg:col-span-2' : 'col-span-1'} rounded-2xl border border-surface-alt bg-white shadow-sm overflow-hidden group transition-shadow duration-200 hover:shadow-md`}>

                {/* PDF preview — lazy-loaded via IntersectionObserver */}
                <div
                  class="relative overflow-hidden bg-surface-alt w-full"
                  style={`aspect-ratio: ${poster.aspectRatio};`}
                >
                  {/* Loading placeholder shown until iframe loads */}
                  <div class="poster-placeholder absolute inset-0 flex items-center justify-center">
                    <svg class="w-8 h-8 text-text-muted/30" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <path stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                        d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                    </svg>
                  </div>

                  <iframe
                    data-src={`${poster.pdf}#toolbar=0&navpanes=0&view=Fit`}
                    class="pdf-iframe absolute inset-0 w-full h-full border-0 pointer-events-none opacity-0 transition-opacity duration-300"
                    title={`${names.join(' & ')} Research Poster`}
                  ></iframe>

                  {/* Hover overlay — opens PDF in new tab */}
                  <a
                    href={poster.pdf}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute inset-0 flex items-end justify-end p-3 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                    aria-label={`Open ${names.join(' & ')} poster in new tab`}
                    tabindex="-1"
                  >
                    <span class="inline-flex items-center gap-1.5 bg-white/90 backdrop-blur-sm text-text-base text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm pointer-events-auto">
                      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                      </svg>
                      Open poster
                    </span>
                  </a>
                </div>

                {/* Fellow info */}
                <div class="p-5 space-y-2.5">
                  <div class="flex items-start justify-between gap-3">
                    <h2 class="text-base font-semibold text-text-base leading-snug">
                      {names.join(' & ')}
                    </h2>
                    <a
                      href={poster.pdf}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="shrink-0 text-primary hover:text-primary/80 transition-colors"
                      aria-label="Open poster PDF"
                    >
                      <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                      </svg>
                    </a>
                  </div>

                  {mentors && (
                    <p class="text-xs text-text-muted">
                      <span class="font-medium" style="color: var(--color-primary);">Mentors: </span>
                      {mentors}
                    </p>
                  )}

                  {poster.fellowIds.length === 1 ? (
                    posterFellows[0]?.projectProposal && (
                      <p class="text-sm text-text-muted leading-relaxed">
                        {truncate(posterFellows[0].projectProposal)}
                      </p>
                    )
                  ) : (
                    <div class="space-y-2">
                      {posterFellows.map(f => f?.projectProposal && (
                        <div>
                          <span class="text-xs font-medium text-text-base">{f.name}: </span>
                          <span class="text-sm text-text-muted leading-relaxed">
                            {truncate(f.projectProposal, 150)}
                          </span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </main>
    <Footer />

    <script>
      // Lazy-load PDF iframes as they scroll into view
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const iframe = entry.target as HTMLIFrameElement;
            const src = iframe.dataset.src;
            if (!src) return;

            iframe.src = src;
            iframe.addEventListener(
              'load',
              () => {
                iframe.classList.remove('opacity-0');
                const placeholder = iframe.parentElement?.querySelector('.poster-placeholder');
                placeholder?.classList.add('hidden');
              },
              { once: true },
            );
            observer.unobserve(iframe);
          });
        },
        { rootMargin: '400px 0px' },
      );

      document.querySelectorAll('.pdf-iframe').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
